+    #[test]
+    fn une_parade_tranquille_de_la_quiescence_peut_repeter_la_position() {
+        // Échec perpétuel à l'horizon : la dame noire va et vient entre e5 et
+        // e1, le roi blanc entre h1 et h2. Dans `entree`, Rh1 est la seule
+        // parade — g1 est tenu par le fou, g2 et h3 sont occupés, rien ne
+        // s'interpose — et elle recrée `z`. Les blancs ont une tour et un
+        // pion de plus : sans la répétition, la quiescence rend un avantage
+        // net. L'arbitre le signalait, « PV continues after threefold
+        // repetition », dans deux des séries de C13 du 29 sept. 2026 — C31.
+        let z = board("7k/1R6/8/2b1q3/8/7P/Q5B1/7K b - - 10 60");
+        let apres_de1 = board("7k/1R6/8/2b5/8/7P/Q5B1/4q2K w - - 11 61");
+        let apres_rh2 = board("7k/1R6/8/2b5/8/7P/Q5BK/4q3 b - - 12 61");
+        let entree = board("7k/1R6/8/2b1q3/8/7P/Q5BK/8 w - - 13 62");
+        let mut a = ardoise();
+
+        let mut temoin = search();
+        temoin.path = vec![entree.hash()];
+        assert!(
+            temoin.negamax(&entree, 0, 1, -INFINITY, INFINITY, &mut a) > 300,
+            "témoin : sans la répétition, la position ne vaut pas zéro"
+        );
+
+        let mut s = search();
+        s.path = vec![z.hash(), apres_de1.hash(), apres_rh2.hash(), entree.hash()];
+        assert_eq!(
+            s.negamax(&entree, 0, 1, -INFINITY, INFINITY, &mut a),
+            DRAW,
+            "la seule parade répète la position : nulle"
+        );
+    }
