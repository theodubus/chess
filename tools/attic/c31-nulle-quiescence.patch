+    #[test]
+    fn une_parade_tranquille_de_la_quiescence_peut_atteindre_le_centieme_demi_coup() {
+        // En échec, la quiescence cherche TOUTES les parades, et une parade
+        // tranquille ne remet pas la pendule à zéro. Ici les trois parades —
+        // Rh2, Dg1, Df1 — sont tranquilles : chacune atteint le centième
+        // demi-coup, et la position vaut nulle. L'arbitre le signalait,
+        // « PV continues after fifty-move rule », deux fois dans les 300
+        // parties de C13 pour N2 (30 sept. 2026) — C31.
+        let mut a = ardoise();
+        let temoin = board("7k/8/8/8/8/8/6Q1/r6K w - - 98 80");
+        assert!(
+            search().negamax(&temoin, 0, 1, -INFINITY, INFINITY, &mut a) > 200,
+            "témoin : à 98 demi-coups, la parade laisse la partie continuer"
+        );
+        let b = board("7k/8/8/8/8/8/6Q1/r6K w - - 99 80");
+        let mut s = search();
+        assert_eq!(
+            s.negamax(&b, 0, 1, -INFINITY, INFINITY, &mut a),
+            DRAW,
+            "à 99 demi-coups, chaque parade atteint le centième : nulle"
+        );
+        // Le nœud d'entrée et ses trois nulles : une nulle compte un nœud,
+        // comme dans negamax.
+        assert_eq!(s.nodes, 4, "chaque nulle compte un nœud");
+    }
