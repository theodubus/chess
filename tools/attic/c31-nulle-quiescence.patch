+    #[test]
+    fn une_nulle_de_la_quiescence_arrete_la_variante() {
+        // Le cavalier peut prendre la tour qui fait échec, mais le fou le
+        // reprend — et le pion a7 garde assez de matériel pour que la reprise
+        // gagne : sans lui, roi et fou contre roi vaudrait zéro, les noirs ne
+        // reprendraient pas, et la ligne restée derrière serait vide. La
+        // prise, cherchée d'abord, laisse donc sa suite — Fxa1 — dans la
+        // ligne du ply suivant. Les parades tranquilles atteignent le
+        // centième demi-coup : nulles, donc meilleures que la prise. La
+        // variante doit s'arrêter à la parade ; recopier la ligne restée
+        // derrière la ferait continuer APRÈS la nulle — l'avertissement même
+        // de l'arbitre (C31).
+        let mut a = ardoise();
+        let temoin = board("7k/p7/8/8/3b4/1N6/8/r6K w - - 98 80");
+        assert!(
+            search().negamax(&temoin, 0, 1, -INFINITY, INFINITY, &mut a) < -200,
+            "témoin : sans la nulle, la prise est le moindre mal, et elle perd"
+        );
+        let b = board("7k/p7/8/8/3b4/1N6/8/r6K w - - 99 80");
+        let mut s = search();
+        assert_eq!(s.negamax(&b, 0, 1, -INFINITY, INFINITY, &mut a), DRAW);
+        assert_eq!(s.pv.lengths[1], 1, "la variante s'arrête à la parade");
+    }
