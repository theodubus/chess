@@ -0,0 +1,85 @@
+//! Sonde C18 — jetable. Une extension d'échec vaut-elle un match ?
+//!
+//! La fiche C18 porte une réserve : « la quiescence explore déjà tous les
+//! coups en échec, donc une partie du bénéfice est peut-être déjà acquise ».
+//! C'est vrai — vérifié dans `quiescence` : en échec, `stand_pat` n'est pas
+//! calculé et `ordered_moves` produit TOUS les coups, pas seulement les
+//! tactiques. Une position en échec n'est donc jamais évaluée statiquement.
+//!
+//! Ce qu'une extension ajoute est donc de la PROFONDEUR, pas une correction :
+//! à la profondeur restante 1, elle remplace une chute en quiescence par une
+//! vraie recherche. La grandeur qui décide est la **part des nœuds en échec à
+//! chaque profondeur restante**, et surtout à la profondeur 1.
+
+use std::io::BufRead;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use cozy_chess::Board;
+use shallowred::position::Position;
+use shallowred::search::{C18_IN_CHECK, C18_NODES, Limits, Search};
+
+fn main() {
+    let profondeur: u32 = std::env::args()
+        .nth(1)
+        .and_then(|a| a.parse().ok())
+        .unwrap_or(10);
+    let limite: usize = std::env::args()
+        .nth(2)
+        .and_then(|a| a.parse().ok())
+        .unwrap_or(400);
+
+    let stop = Arc::new(AtomicBool::new(false));
+    let mut search = Search::new(stop);
+    let limits = Limits {
+        depth: Some(profondeur),
+        ..Limits::default()
+    };
+
+    let mut positions = 0usize;
+    for line in std::io::stdin().lock().lines().map_while(Result::ok) {
+        if positions >= limite {
+            break;
+        }
+        let fen = line.split(';').next().unwrap_or("").trim();
+        let Ok(board) = fen.parse::<Board>() else {
+            continue;
+        };
+        positions += 1;
+        search.clear_table();
+        let position = Position::from_board(board);
+        let _ = search.go(&position, &limits, |_| {});
+    }
+
+    let lire = |t: &[AtomicU64; 5], i: usize| t[i].load(Ordering::Relaxed);
+    let pct = |a: u64, b: u64| if b == 0 { 0.0 } else { 100.0 * a as f64 / b as f64 };
+
+    let total: u64 = (0..5).map(|i| lire(&C18_NODES, i)).sum();
+    let total_echec: u64 = (0..5).map(|i| lire(&C18_IN_CHECK, i)).sum();
+
+    println!("positions   {positions}");
+    println!("profondeur  {profondeur}");
+    println!();
+    println!("profondeur restante        nœuds      en échec    part      part de tous les nœuds");
+    for i in 0..5 {
+        let n = lire(&C18_NODES, i);
+        let c = lire(&C18_IN_CHECK, i);
+        let nom = match i {
+            0 => "quiescence".to_string(),
+            4 => ">= 4".to_string(),
+            d => format!("{d}"),
+        };
+        println!(
+            "{nom:<18} {n:>14} {c:>13}  {:>6.2} %   {:>6.3} %",
+            pct(c, n),
+            pct(n, total)
+        );
+    }
+    println!();
+    println!("tous nœuds  {total:>14} {total_echec:>13}  {:>6.2} %", pct(total_echec, total));
+    println!();
+    println!("Ce qu'une extension change : les nœuds EN ÉCHEC hors quiescence,");
+    println!("soit {} nœuds, {:.3} % de l'arbre.",
+        total_echec - lire(&C18_IN_CHECK, 0),
+        pct(total_echec - lire(&C18_IN_CHECK, 0), total));
+}
