+/// SONDE N23 — variantes de MESURE de l'historique borné (phase 4), choisies
+/// par la variable d'environnement `N23`, combinables par « + » ; sans elle,
+/// `main` au nœud près :
+/// - `g:D` — la gravité : `note += b − note·|b|/D`, au papillon et à la
+///   continuation, sans division de la table ; `|note| ≤ D` ;
+/// - `gc:D` — un plafond propre à la continuation (défaut : celui de `g`) ;
+/// - `lin:A:C`, `lin:A:B:C` — le bonus et le malus valent
+///   `clamp(A·d − B, 1, C)` au lieu de `d²` ;
+/// - `hk` — le papillon n'est plus vidé à chaque `go` ;
+/// - `lmrh:K` — la réduction d'un tranquille diminue de sa note / `K`
+///   (augmente si la note est négative), bornée à `[0, d − 2]` ;
+/// - `hp:T` — l'élagage par l'historique : un tranquille de note sous
+///   `−T·d` se saute à la profondeur ≤ 4, avec les gardes de la futilité ;
+///   `hpo:T` — le même en ombre : compté, pas sauté.
+#[derive(Default, Clone, Copy)]
+struct N23 {
+    g: Option<i32>,
+    gc: Option<i32>,
+    lin: Option<(i32, i32, i32)>,
+    hk: bool,
+    lmrh: Option<i32>,
+    hp: Option<i32>,
+    hpo: Option<i32>,
+}
+
+fn n23() -> N23 {
+    static V: std::sync::OnceLock<N23> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N23::default();
+        let brut = std::env::var("N23").unwrap_or_default();
+        for part in brut.split('+').filter(|p| !p.is_empty()) {
+            let n: Vec<i32> = part.split(':').skip(1).filter_map(|x| x.parse().ok()).collect();
+            match (part.split(':').next().unwrap_or(""), &n[..]) {
+                ("g", [d]) => v.g = Some(*d),
+                ("gc", [d]) => v.gc = Some(*d),
+                ("lin", [a, c]) => v.lin = Some((*a, 0, *c)),
+                ("lin", [a, b, c]) => v.lin = Some((*a, *b, *c)),
+                ("hk", []) => v.hk = true,
+                ("lmrh", [k]) => v.lmrh = Some(*k),
+                ("hp", [t]) => v.hp = Some(*t),
+                ("hpo", [t]) => v.hpo = Some(*t),
+                _ => panic!("N23 : variante inconnue « {part} »"),
+            }
+        }
+        v
+    })
+}
+
+/// SONDE N23 — les compteurs, dans l'ordre de [`N23_NOMS`].
+pub static N23C: [std::sync::atomic::AtomicU64; 5] = [
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+];
+/// SONDE N23 — les noms : tranquilles éligibles à LMR, réduction changée par
+/// `lmrh`, sautés (ou qui le seraient) par l'historique, et parmi eux ceux
+/// qui, cherchés, montent `alpha` (ombre seulement) ; toutes les montées
+/// d'`alpha` de `negamax`, le dénominateur des dégâts.
+pub const N23_NOMS: [&str; 5] = ["lmr", "lmrh_change", "hp_saute", "hp_monte", "alpha"];
+
+fn n23c(k: usize) {
+    if let Some(c) = N23C.get(k) {
+        c.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// SONDE N23 — le bonus (et le malus) d'une coupure à la profondeur `d`.
+fn n23_bonus(depth: i32) -> i32 {
+    match n23().lin {
+        Some((a, b, c)) => (a * depth - b).min(c).max(1),
+        None => depth * depth,
+    }
+}
+
+/// SONDE N23 — la gravité : rend `true` si la table doit se diviser.
+fn n23_apply(value: &mut i32, delta: i32, cap: Option<i32>) -> bool {
+    match cap {
+        Some(d) => {
+            let delta = delta.clamp(-d, d);
+            let decay = (i64::from(*value) * i64::from(delta.abs()) / i64::from(d)) as i32;
+            *value += delta - decay;
+            false
+        }
+        None => {
+            *value += delta;
+            value.abs() > HISTORY_MAX
+        }
+    }
+}
