+#!/usr/bin/env python3
+"""Rejoue les parties d'un PGN (notation UCI, sortie de fastchess) dans un
+binaire, chaque position cherchée par `go depth D` : deux flux par partie, un
+par camp, comme en match — table et historiques conservés d'un coup à
+l'autre. Déterministe à un fil. Rend le total des nœuds et la somme des
+compteurs `info string sonde-n23`.
+
+    N23=g:7183 python3 rejouer.py <pgn> <binaire> <D> [processus]
+"""
+import re
+import subprocess
+import sys
+from collections import defaultdict
+from concurrent.futures import ThreadPoolExecutor
+
+pgn, binaire, prof = sys.argv[1], sys.argv[2], int(sys.argv[3])
+proc = int(sys.argv[4]) if len(sys.argv) > 4 else 4
+COUP = re.compile(r'^[a-h][1-8][a-h][1-8][qrbn]?$')
+SONDE = re.compile(r'info string sonde-n23 (.*)$')
+
+parties, fen, coups = [], None, []
+for ligne in open(pgn, errors='replace'):
+    ligne = ligne.strip()
+    if ligne.startswith('[Event'):
+        if coups or fen:
+            parties.append((fen, coups))
+        fen, coups = None, []
+    elif ligne.startswith('[FEN '):
+        fen = ligne[6:-2]
+    elif ligne and not ligne.startswith('['):
+        sans = re.sub(r'\{[^}]*\}', ' ', ligne)
+        coups += [t for t in sans.split() if COUP.match(t)]
+if coups or fen:
+    parties.append((fen, coups))
+
+flux = []
+for i, (f, c) in enumerate(parties):
+    trait0 = 0 if (f is None or f.split()[1] == 'w') else 1
+    for camp in (0, 1):
+        plis = [k for k in range(len(c)) if (trait0 + k) % 2 == camp]
+        flux.append((i, camp, f, c, plis))
+
+
+def rejouer(item):
+    i, camp, f, c, plis = item
+    p = subprocess.Popen([binaire], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                         text=True, bufsize=1)
+
+    def envoyer(s):
+        p.stdin.write(s + '\n')
+        p.stdin.flush()
+
+    def attendre(fin):
+        nodes, sonde = None, {}
+        while True:
+            l = p.stdout.readline()
+            if not l:
+                sys.exit("le moteur s'est tu")
+            if l.startswith('info depth') and ' nodes ' in l:
+                nodes = int(l.split(' nodes ')[1].split()[0])
+            m = SONDE.search(l)
+            if m:
+                sonde = {k: int(v) for k, v in (x.split('=') for x in m[1].split())}
+            if l.startswith(fin):
+                return nodes, sonde
+
+    envoyer('uci')
+    attendre('uciok')
+    envoyer('ucinewgame')
+    envoyer('isready')
+    attendre('readyok')
+    base = f'position fen {f}' if f else 'position startpos'
+    somme, compteurs = 0, defaultdict(int)
+    for k in plis:
+        envoyer(base + (' moves ' + ' '.join(c[:k]) if k else ''))
+        envoyer(f'go depth {prof}')
+        nodes, sonde = attendre('bestmove')
+        somme += nodes or 0
+        for a, v in sonde.items():
+            compteurs[a] += v
+    envoyer('quit')
+    p.wait(timeout=30)
+    return len(plis), somme, compteurs
+
+
+total, recherches, tous = 0, 0, defaultdict(int)
+with ThreadPoolExecutor(max_workers=proc) as ex:
+    for n, somme, compteurs in ex.map(rejouer, flux):
+        total += somme
+        recherches += n
+        for a, v in compteurs.items():
+            tous[a] += v
+print(f"PARTIES {len(parties)} RECHERCHES {recherches} NOEUDS {total}")
+print("SONDE " + ' '.join(f'{a}={v}' for a, v in sorted(tous.items())))
