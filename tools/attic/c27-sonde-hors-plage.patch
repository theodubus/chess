index 0000000..ba414cb
--- /dev/null
+++ b/tools/sonde-c27/lire.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# Lecteur de la sonde C27 : agrège les lignes `info string sonde-c27` qu'émet
+# le moteur instrumenté avant chaque `bestmove`, dans un journal cutechess
+# lancé avec `-debug all`.
+#
+# Le match du 25 sept. 2026 (ancien code instrumenté contre lui-même) :
+#   tools/arbiters/cutechess-cli -engine cmd=$BIN name=a -engine cmd=$BIN name=b \
+#     -each proto=uci tc=8+0.08 -openings file=tools/book.epd format=epd \
+#     order=random -repeat -games 2 -rounds 30 -concurrency 3 -srand 20260925 \
+#     -debug all > c27-sonde.log
+#
+# `bornee` est INUTILISABLE tel quel : il compte aussi le bornage trivial d'une
+# borne infinie. Seuls `hors_plage` et `couperait` répondent à la question.
+set -euo pipefail
+grep -o "sonde-c27 hors_plage=[0-9]* bornee=[0-9]* couperait=[0-9]*" "${1:?journal}" |
+  awk -F'[= ]' '{n++; h+=$3; c+=$7; if($3>0) nh++; if($7>0) nc++}
+    END {printf "recherches %d\nhors_plage : %d écritures, %d recherches (%.2f %%)\ncouperait : %d nœuds, %d recherches (%.2f %%)\n", n, h, nh, 100*nh/n, c, nc, 100*nc/n}'
