+    /// SONDE, pas un critère : de combien la fenêtre d'aspiration change-t-elle
+    /// le score quand PVS est en place ?
+    ///
+    /// `#[ignore]` parce qu'elle mesure au lieu de vérifier, et qu'elle prend
+    /// des minutes. Lancer par `cargo test --release -- --ignored sonde_`.
+    #[test]
+    #[ignore]
+    fn sonde_instabilite_de_laspiration_sous_pvs() {
+        // Marche pseudo-aléatoire seedée : un échantillon de positions jouées,
+        // pas le banc — celui-ci n'est pas un échantillon de jeu.
+        let mut positions = Vec::new();
+        for graine in 1..=40u64 {
+            let mut etat = (graine * 2_654_435_761) | 1;
+            let mut b = Board::default();
+            for pli in 0..60 {
+                let mut coups = Vec::new();
+                b.generate_moves(|set| {
+                    coups.extend(set);
+                    false
+                });
+                if coups.is_empty() {
+                    break;
+                }
+                if pli % 15 == 14 && b.checkers().is_empty() {
+                    positions.push(b.clone());
+                }
+                etat ^= etat << 13;
+                etat ^= etat >> 7;
+                etat ^= etat << 17;
+                let mv = coups[(etat as usize) % coups.len()];
+                b.play_unchecked(mv);
+            }
+        }
+
+        // LMP est désactivé dans LES DEUX bras : le test qui échoue le fait,
+        // et le laisser actif ferait varier deux choses à la fois. Première
+        // version de cette sonde : je l'avais laissé actif et j'ai lu 25 %
+        // contre 27 % comme « PVS n'y est pour rien », alors que je mesurais
+        // l'effet de LMP dans les deux bras. Mauvais dénominateur, cinquième
+        // fois sur ce projet.
+        for pvs in [true, false] {
+            let mut differents = 0u32;
+            let mut ecart_max = 0i32;
+            let mut somme = 0i64;
+            for b in &positions {
+                let mut plein = search_sans_lmp();
+                plein.full_window_only = !pvs;
+                let reference = plein.negamax(b, 5, 0, -INFINITY, INFINITY, &mut ardoise());
+                for pari in [5_000, -5_000, 0] {
+                    let mut s = search_sans_lmp();
+                    s.full_window_only = !pvs;
+                    let score = s.search_root(b, 5, 8, pari, &mut ardoise());
+                    if score != reference {
+                        differents += 1;
+                        let d = (score - reference).abs();
+                        ecart_max = ecart_max.max(d);
+                        somme += i64::from(d);
+                    }
+                }
+            }
+            let total = positions.len() * 3;
+            println!(
+                "PVS={pvs} : {differents}/{total} scores changés par le pari \
+                 ({:.1} %), écart max {ecart_max} cp, écart moyen sur les \
+                 changés {:.1} cp",
+                100.0 * f64::from(differents) / total as f64,
+                if differents == 0 {
+                    0.0
+                } else {
+                    somme as f64 / f64::from(differents)
+                }
+            );
+        }
+    }
