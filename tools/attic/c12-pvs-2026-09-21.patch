+    #[test]
+    fn la_fenetre_nulle_reduit_bien_larbre() {
+        // Sans le commutateur, ce test ne pourrait comparer que deux appels
+        // identiques. Le nombre de nœuds est déterministe : il tranche sans
+        // incertitude que le mécanisme agit — pas qu'il rapporte de l'Elo,
+        // ce que seul un SPRT peut dire.
+        let b = board("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1");
+
+        let mut avec = search();
+        let mut a1 = ardoise();
+        avec.negamax(&b, 6, 0, -INFINITY, INFINITY, &mut a1);
+
+        let mut sans = search();
+        sans.full_window_only = true;
+        let mut a2 = ardoise();
+        sans.negamax(&b, 6, 0, -INFINITY, INFINITY, &mut a2);
+
+        assert_ne!(
+            avec.nodes, sans.nodes,
+            "la fenêtre nulle ne change rien à l'arbre — elle est donc inerte"
+        );
+    }
