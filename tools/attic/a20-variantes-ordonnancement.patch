+    /// EXPÉRIENCE A20 : ce que chaque variante apprend d'un coupeur tranquille.
+    fn a20_learn(
+        &mut self,
+        board: &Board,
+        mv: Move,
+        depth: i32,
+        p1: Option<usize>,
+        p2: Option<usize>,
+        tried: &[Move],
+    ) {
+        let bonus = depth * depth;
+        match self.a20 {
+            1 => {
+                if let Some(p) = p1 {
+                    self.a20_cm[p] = pack_move(mv);
+                }
+            }
+            2 | 3 => {
+                let pt = a20_pt_of(board, mv);
+                let mut overflow = false;
+                for p in [p1, p2].into_iter().flatten() {
+                    let e = &mut self.a20_ch[p * A20_PT + pt];
+                    *e += bonus;
+                    overflow |= *e > HISTORY_MAX;
+                }
+                if overflow {
+                    for e in &mut self.a20_ch {
+                        *e /= 2;
+                    }
+                }
+            }
+            5 => {
+                // Le malus suit la convention du bonus : − d², borné par
+                // HISTORY_MAX en négatif comme le bonus l'est en positif.
+                for &q in tried {
+                    if let Some(e) = self.history.get_mut(q.from as usize * 64 + q.to as usize) {
+                        *e = (*e - bonus).max(-HISTORY_MAX);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
