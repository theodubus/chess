@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Rejoue les flux de commandes d'un journal cutechess `-debug all` dans un
+binaire, chaque `go` remplacé par `go depth D` : mêmes positions, dans l'ordre
+des parties, table et historiques conservés d'un coup à l'autre comme en
+partie. Rend le total des nœuds par flux — déterministe à un fil, donc
+comparable au nœud près entre deux binaires ou deux variantes.
+
+    A20=cm python3 rejouer-profondeur.py <journal> <binaire> <D> <flux,...>
+"""
+import re
+import subprocess
+import sys
+from collections import defaultdict
+
+CMD = re.compile(r'^\d+ >(\w+)\((\d+)\): (.*)$')
+flux = defaultdict(list)
+for brut in open(sys.argv[1], errors='replace'):
+    m = CMD.match(brut.rstrip('\n'))
+    if m:
+        flux[(m[1], m[2])].append(m[3])
+cles = sorted(flux, key=lambda k: (k[0], int(k[1])))
+profondeur = sys.argv[3]
+choisis = [cles[int(i)] for i in sys.argv[4].split(',')] if len(sys.argv) > 4 else cles
+
+def attendre(p, fin):
+    nodes = None
+    while True:
+        ligne = p.stdout.readline()
+        if not ligne:
+            sys.exit("le moteur s'est tu")
+        if ligne.startswith('info depth') and ' nodes ' in ligne:
+            nodes = int(ligne.split(' nodes ')[1].split()[0])
+        if ligne.startswith(fin):
+            return nodes
+
+total, recherches = 0, 0
+for cle in choisis:
+    p = subprocess.Popen([sys.argv[2]], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                         text=True, bufsize=1)
+    def envoyer(s):
+        p.stdin.write(s + '\n')
+        p.stdin.flush()
+    envoyer('uci')
+    attendre(p, 'uciok')
+    somme, n = 0, 0
+    for cmd in flux[cle]:
+        if cmd in ('uci', 'quit') or cmd.startswith('debug'):
+            continue
+        if cmd.startswith('go'):
+            envoyer(f'go depth {profondeur}')
+            somme += attendre(p, 'bestmove') or 0
+            n += 1
+        elif cmd == 'isready':
+            envoyer('isready')
+            attendre(p, 'readyok')
+        else:
+            envoyer(cmd)
+    envoyer('quit')
+    p.wait(timeout=30)
+    print(f"{cle[0]}({cle[1]}) {n} {somme}", flush=True)
+    total += somme
+    recherches += n
+print(f"TOTAL {recherches} {total}")
