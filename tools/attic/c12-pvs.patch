+    #[test]
+    fn la_fenetre_nulle_ne_change_pas_le_coup_trouve_sur_un_mat() {
+        // PVS ne doit jamais coûter un mat : un coup de mat dépasse forcément
+        // alpha, donc il est re-cherché en fenêtre pleine. Si la re-recherche
+        // manquait, le mat serait vu comme un simple minorant et pourrait être
+        // classé derrière un autre coup.
+        assert_eq!(
+            best(
+                "r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5Q2/PPPP1PPP/RNB1K1NR w KQkq - 0 1",
+                7
+            ),
+            "f3f7"
+        );
+        assert_eq!(
+            best(
+                "rnbqkbnr/pppp1ppp/8/4p3/6P1/5P2/PPPPP2P/RNBQKBNR b KQkq - 0 2",
+                7
+            ),
+            "d8h4"
+        );
+    }
