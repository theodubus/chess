+                .unwrap();
+        let limits = Limits {
+            depth: Some(6),
+            ..Limits::default()
+        };
+        let mut lignes = Vec::new();
+        let mut s = search();
+        s.go(&position, &limits, |info| lignes.push(info.pv.clone()));
+        let derniere = lignes.last().unwrap();
+        assert!(
+            derniere.len() >= 2,
+            "la variante principale doit survivre à PVS : {derniere:?}"
+        );
+        let mut b = position.board().clone();
+        for mv in derniere {
+            assert!(b.is_legal(*mv), "coup illégal dans la PV : {mv}");
+            b.play_unchecked(*mv);
+        }
+    }
