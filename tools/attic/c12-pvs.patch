+    #[test]
+    fn la_fenetre_nulle_rend_le_meme_score_que_la_fenetre_pleine() {
+        // Propriété centrale de PVS : il accélère, il ne décide pas. Le score
+        // exact d'un nœud ne doit pas dépendre du fait qu'on ait d'abord
+        // sondé ses coups en fenêtre nulle.
+        //
+        // Deux instances neuves, donc deux tables vides : les deux mesures
+        // sont déterministes et ne diffèrent que par le régime de fenêtre. Un
+        // écart signalerait une re-recherche manquante.
+        for fen in [
+            "r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/8/PPPP1PPP/RNBQK1NR w KQkq - 0 1",
+            "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10",
+            "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+            "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+        ] {
+            let b = board(fen);
+            let avec = search().negamax(&b, 5, 0, -INFINITY, INFINITY);
+
+            let mut sans = search();
+            sans.full_window_only = true;
+            let sans = sans.negamax(&b, 5, 0, -INFINITY, INFINITY);
+
+            assert_eq!(avec, sans, "{fen}");
+            assert!(avec.abs() < MATE_THRESHOLD, "{fen} : score invraisemblable");
+        }
+    }
