+    /// SONDE A20 : note chaque coup de l'étage tranquille sous chaque
+    /// variante, dans l'état où un sélecteur aurait lu les tables.
+    fn sonde_snapshot(
+        &mut self,
+        board: &Board,
+        ply: usize,
+        p1: Option<usize>,
+        p2: Option<usize>,
+        quiets: &[(Move, i32)],
+    ) {
+        let base = ply * MAX_MOVES * SONDE_V;
+        let cm = p1
+            .and_then(|p| self.sonde_cm.get(p).copied())
+            .filter(|&c| c != 0);
+        for (j, &(mv, butterfly)) in quiets.iter().enumerate() {
+            let pt = sonde_pt(board, mv);
+            let ch = |t: &[i32], p: Option<usize>| p.map_or(0i64, |p| i64::from(t[p * SONDE_PT + pt]));
+            let is_cm = cm == Some(pack_move(mv));
+            let cont = ch(&self.sonde_ch, p1) + ch(&self.sonde_ch, p2);
