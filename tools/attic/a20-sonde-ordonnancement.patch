+            // décalée de 24 bits le domine sans jamais le toucher.
+            let lexi = (cont << 24) + i64::from(butterfly);
+            let kept = i64::from(self.sonde_hk[mv.from as usize * 64 + mv.to as usize]);
+            let keys = [
+                if is_cm { i64::MAX } else { i64::from(butterfly) },
+                i64::from(butterfly) + cont,
+                lexi,
+                kept,
+                kept + cont,
+            ];
+            let at = base + j * SONDE_V;
+            if let Some(slot) = self.sonde_keys.get_mut(at..at + SONDE_V) {
+                slot.copy_from_slice(&keys);
+            }
+        }
+    }
