+        sonde_add(1, 1);
+        if index == 0 {
+            sonde_add(2, 1);
+        }
+        sonde_add(3 + stage as usize, 1);
+        sonde_add(9, spent_all);
+        if stage == 3 {
+            sonde_add(7, qindex as u64);
+            if qindex == 0 {
+                sonde_add(8, 1);
+            }
+            sonde_add(10, spent_quiet);
+            sonde_add(24, qlen as u64);
+            if reduced {
