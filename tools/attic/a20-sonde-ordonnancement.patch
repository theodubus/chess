+            }
+            for p in [p1, p2].into_iter().flatten() {
+                let e = &mut self.sonde_ch[p * SONDE_PT + pt];
+                *e = e.saturating_add(bonus);
+            }
+            // Le papillon conservé suit la règle du vrai : + d², moitié de
+            // toute la table au-delà de HISTORY_MAX.
+            let e = &mut self.sonde_hk[mv.from as usize * 64 + mv.to as usize];
+            *e += bonus;
+            if *e > HISTORY_MAX {
+                for x in &mut self.sonde_hk {
+                    *x /= 2;
+                }
+            }
+        }
+    }
