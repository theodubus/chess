+pub static SONDES: [AtomicU64; 40] = [const { AtomicU64::new(0) }; 40];
+fn sonde_add(i: usize, v: u64) {
+    SONDES[i].fetch_add(v, Ordering::Relaxed);
+}
+/// Pièce colorée × case d'arrivée : l'index d'un coup dans les tables
+/// contrefactuelles de la sonde.
+const SONDE_PT: usize = 12 * 64;
+fn sonde_gravity(e: &mut i32, b: i32) {
+    *e += b - *e * b.abs() / 16_384;
+}
+fn sonde_pt(board: &Board, mv: Move) -> usize {
+    let piece = board.piece_on(mv.from).map_or(0, |p| p as usize);
+    board.side_to_move() as usize * 6 * 64 + piece * 64 + mv.to as usize
+}
