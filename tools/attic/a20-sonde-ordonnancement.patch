+            }
+            // Rangs contrefactuels : combien de coups de l'étage passeraient
+            // devant le coupeur. Les ex æquo comptent pour moitié — le tri est
+            // instable —, d'où le double.
+            let base = ply * MAX_MOVES * SONDE_V;
+            for v in 0..SONDE_V {
+                let key = |j: usize| self.sonde_keys[base + j * SONDE_V + v];
+                let k = key(qindex);
+                let (mut above, mut ties) = (0u64, 0u64);
+                for j in (0..qlen).filter(|&j| j != qindex) {
+                    let x = key(j);
+                    if x > k {
+                        above += 1;
+                    } else if x == k {
+                        ties += 1;
+                    }
+                }
+                let at = if v < 4 { 12 + 2 * v } else { 32 + 2 * (v - 4) };
+                sonde_add(at, 2 * above + ties);
+                if above == 0 && ties == 0 {
+                    sonde_add(at + 1, 1);
+                }
+            }
+            let cm = p1
+                .and_then(|p| self.sonde_cm.get(p).copied())
+                .filter(|&c| c != 0);
+            if let Some(c) = cm {
+                if c == pack_move(mv) {
+                    sonde_add(20, 1);
+                } else if (0..qlen).any(|j| self.sonde_keys[base + j * SONDE_V] == i64::MAX) {
+                    sonde_add(21, 1);
+                }
+            }
