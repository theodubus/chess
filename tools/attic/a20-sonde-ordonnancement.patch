+#!/usr/bin/env python3
+"""Lecteur de la sonde A20 — ce que l'ordre des coups tranquilles laisse sur
+la table, et ce que les raffinements décidés y changeraient.
+
+Lit un journal cutechess-cli `-debug all` d'un match joué par le binaire
+sondé contre lui-même : le régime réel, table et historiques accumulés comme
+en partie (piège du moteur froid, CLAUDE.md). Chaque processus imprime ses
+compteurs CUMULÉS avant chaque `bestmove` ; la dernière ligne d'un processus
+vaut pour tout ce qu'il a cherché.
+
+    QT_QPA_PLATFORM=offscreen tools/arbiters/cutechess-cli -debug all \\
+      -engine cmd=SONDE name=a proto=uci -engine cmd=SONDE name=b proto=uci \\
+      -each tc=8+0.08 -openings file=tools/book.epd format=epd order=random \\
+      -srand 20260925 -games 2 -repeat -rounds 60 -concurrency 3 \\
+      -draw movenumber=40 movecount=8 score=10 \\
+      -resign movecount=4 score=600 twosided=true > sonde.log
+    python3 tools/sonde-a20/analyser.py sonde.log
+
+Compteurs (`SONDES`, `engine/src/search.rs`) :
+   0 nœuds de `negamax` qui atteignent la boucle des coups
+   1 coupures bêta ; 2 dont au premier coup
+   3-6 étage du coupeur : table, tactique, killer, étage tranquille
+   7 somme des indices du coupeur dans l'étage tranquille ; 8 à l'indice 0
+   9-10 sommes NAÏVES des sous-arbres perdus (tous étages ; étage tranquille)
+        — comptent deux fois les emboîtements, gardées pour mémoire
+  11 nœuds totaux
+  12-19, 32-33 par variante : 2 × somme des rangs contrefactuels du coupeur
+        (ex æquo pour moitié), puis coupeur strictement premier
+  20 coup de réfutation présent et coupeur ; 21 présent dans l'étage et faux
+  22 coupeur de l'étage réduit par LMR ; 23 alpha monte sans coupure
+  24 somme des tailles de l'étage aux coupures de l'étage
+  25 UNION des sous-arbres cherchés avant un coupeur ; 26 celle de l'étage
+     tranquille (emboîtements sous d'autres étages permis)
+  27 nœuds des recherches de racine ACHEVÉES — le dénominateur des unions
+  28-31 union ventilée par l'étage du coup perdu, au niveau le plus haut
+"""
+import math
+import re
+import sys
+
+LIGNE = re.compile(r'^\d+ <(\w+)\((\d+)\): info string sonde (.*)$')
+derniere = {}
+for brut in open(sys.argv[1], errors='replace'):
+    m = LIGNE.match(brut.rstrip('\n'))
+    if m:
+        derniere[(m[1], m[2])] = list(map(int, m[3].split()))
+if not derniere:
+    sys.exit("aucune ligne de sonde")
+n = max(len(v) for v in derniere.values())
+t = [sum(v[i] for v in derniere.values() if i < len(v)) for i in range(n)]
+
+def pc(a, b):
+    return 100 * a / b if b else float('nan')
+
+def plis(f):
+    """Plis d'une épargne de f % des nœuds : 1,36 pli par doublement."""
+    return math.copysign(1.36 * math.log2(1 / (1 - abs(f) / 100)), f)
+
