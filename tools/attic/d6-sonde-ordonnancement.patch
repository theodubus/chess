+++ b/tools/src/bin/staged_probe.rs
@@ -0,0 +1,70 @@
+//! SONDE JETABLE — majore ce qu'un générateur par étapes peut épargner.
+//!
+//! La question n'est PAS « quelle part des nœuds est en quiescence » (90 %,
+//! et c'est le mauvais dénominateur : `tactical_only` y restreint déjà la
+//! génération par un `AND` de bitboards). La question est **combien de coups
+//! sont générés, scorés et triés sans jamais être cherchés**, et **combien de
+//! nœuds n'ont besoin d'aucun coup tranquille** — ceux-là pourraient ne pas
+//! en générer du tout.
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use cozy_chess::Board;
+use shallowred::position::Position;
+use shallowred::search::{
+    Limits, P_CUT, P_GEN, P_GEN_QF, P_GEN_QUIET, P_NODES, P_QUIETFREE, P_SEARCHED, Search,
+};
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let path = args.next().unwrap_or_else(|| "positions.fen".into());
+    let depth: u32 = args.next().and_then(|a| a.parse().ok()).unwrap_or(10);
+
+    let fens = std::fs::read_to_string(&path).expect("corpus illisible");
+    let stop = Arc::new(AtomicBool::new(false));
+    let mut search = Search::new(stop);
+    let limits = Limits {
+        depth: Some(depth),
+        ..Limits::default()
+    };
+
+    let mut positions = 0u32;
+    for line in fens.lines() {
+        let line = line.trim();
+        if line.is_empty() {
+            continue;
+        }
+        let Ok(board) = line.parse::<Board>() else {
+            continue;
+        };
+        search.clear_table();
+        let _ = search.go(&Position::from_board(board), &limits, |_| {});
+        positions += 1;
+    }
+
+    let g = |c: &[std::sync::atomic::AtomicU64; 2], i: usize| c[i].load(Ordering::Relaxed);
+    println!("positions   : {positions}  (profondeur {depth})");
+    for (i, nom) in ["negamax", "quiescence"].iter().enumerate() {
+        let nodes = g(&P_NODES, i);
+        let genere = g(&P_GEN, i);
+        let quiet = g(&P_GEN_QUIET, i);
+        let searched = g(&P_SEARCHED, i);
+        let cut = g(&P_CUT, i);
+        let pct = |a: u64, b: u64| if b == 0 { 0.0 } else { 100.0 * a as f64 / b as f64 };
+        println!("\n--- {nom} ---");
+        println!("nœuds avec coups        : {nodes}");
+        println!("coups générés+scorés+triés : {genere}  ({:.2} / nœud)", genere as f64 / nodes as f64);
+        println!("  dont tranquilles      : {quiet}  ({:.1} %)", pct(quiet, genere));
+        println!("coups réellement cherchés : {searched}  ({:.2} / nœud)", searched as f64 / nodes as f64);
+        println!("** coups jamais cherchés : {}  ({:.1} % du généré) **", genere - searched, pct(genere - searched, genere));
+        println!("nœuds coupés sur bêta   : {cut}  ({:.1} %)", pct(cut, nodes));
+        if i == 0 {
+            let qf = g(&P_QUIETFREE, 0);
+            println!("** nœuds sans AUCUN tranquille cherché : {qf}  ({:.1} %) **", pct(qf, nodes));
+            let gqf = g(&P_GEN_QF, 0);
+            println!("   coups générés à ces nœuds : {gqf}  ({:.2} / nœud, contre {:.2} en moyenne)", gqf as f64 / qf as f64, genere as f64 / nodes as f64);
+            let gqf = g(&P_GEN_QF, 0);
+            println!("   coups générés à ces nœuds : {gqf}  ({:.2} / nœud, contre {:.2} en moyenne)", gqf as f64 / qf as f64, genere as f64 / nodes as f64);
+        }
+    }
+}
