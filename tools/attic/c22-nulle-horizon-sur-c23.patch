+        assert_eq!(
+            search().negamax(&b, 0, 1, -INFINITY, INFINITY, &mut a),
+            DRAW,
+            "à 100 demi-coups, c'est nul — à l'horizon comme ailleurs"
+        );
+        assert_eq!(
+            search().negamax(&b, 2, 1, -INFINITY, INFINITY, &mut a),
