+    /// SONDE C36 — jetable, à l'attic : `C36_POSITIONS=<fichier>`
+    /// `[C36_DEPTH=7] cargo test --release -- --ignored sonde_c36 --nocapture`.
+    #[test]
+    #[ignore]
+    fn sonde_c36_le_compte_retire_des_noeuds_en_general() {
+        let path = std::env::var("C36_POSITIONS").unwrap();
+        let depth: u32 = std::env::var("C36_DEPTH")
+            .ok()
+            .map_or(7, |d| d.parse().unwrap());
+        let limits = Limits {
+            depth: Some(depth),
+            ..Limits::default()
+        };
+        let (mut total_avec, mut total_sans) = (0_u64, 0_u64);
+        let (mut moins, mut plus, mut egal) = (0, 0, 0);
+        for (i, line) in std::fs::read_to_string(path).unwrap().lines().enumerate() {
+            let tokens: Vec<&str> = line.split_whitespace().collect();
+            let (mut position, rest) = match tokens.first() {
+                Some(&"startpos") => (Position::startpos(), &tokens[1..]),
+                Some(&"fen") => {
+                    let end = tokens
+                        .iter()
+                        .position(|t| *t == "moves")
+                        .unwrap_or(tokens.len());
+                    (
+                        Position::from_fen(&tokens[1..end].join(" ")).unwrap(),
+                        &tokens[end..],
+                    )
+                }
+                _ => panic!("ligne illisible : {line}"),
+            };
+            if rest.first() == Some(&"moves") {
+                for mv in &rest[1..] {
+                    position.play_uci(mv).unwrap();
+                }
+            }
+            let mut avec = search();
+            avec.go(&position, &limits, |_| {});
+            let mut sans = search_sans_lmp();
+            sans.go(&position, &limits, |_| {});
+            let (a, b) = (avec.nodes(), sans.nodes());
+            println!("C36 {i} {a} {b}");
+            total_avec += a;
+            total_sans += b;
+            match a.cmp(&b) {
+                std::cmp::Ordering::Less => moins += 1,
+                std::cmp::Ordering::Greater => plus += 1,
+                std::cmp::Ordering::Equal => egal += 1,
+            }
+        }
+        println!(
+            "C36 TOTAL profondeur {depth} : avec {total_avec}, sans {total_sans}, \
+             rapport {:.4} ; avec < sans {moins}, avec > sans {plus}, égal {egal}",
+            total_avec as f64 / total_sans as f64
+        );
+    }
