+#!/usr/bin/env python3
+"""Extrait d'un journal cutechess `-debug all` les positions cherchées — la
+dernière commande `position` avant chaque `go`, par flux —, distinctes, dans
+l'ordre des parties : une par ligne, sans le mot `position`, ce que lit la
+sonde `sonde_c36_le_compte_retire_des_noeuds_en_general`.
+
+    python3 positions.py <journal> > positions.txt
+    C36_POSITIONS=positions.txt cargo test --release -p shallowred --lib \\
+        sonde_c36 -- --ignored --nocapture
+
+Sur le journal de l'écran du n° 9 (60 parties) : 5 276 recherches, 4 684
+positions distinctes.
+"""
+import re
+import sys
+
+CMD = re.compile(r'^\d+ >(\w+)\((\d+)\): (.*)$')
+derniere, vues = {}, set()
+for brut in open(sys.argv[1], errors='replace'):
+    m = CMD.match(brut.rstrip('\n'))
+    if not m:
+        continue
+    flux, cmd = (m[1], m[2]), m[3]
+    if cmd.startswith('position '):
+        derniere[flux] = cmd[len('position '):]
+    elif cmd.startswith('go') and flux in derniere and derniere[flux] not in vues:
+        vues.add(derniere[flux])
+        print(derniere[flux])
