+    /// La borne de l'extension, éprouvée sur la fonction plutôt que sur un
+    /// symptôme.
+    ///
+    /// C'est la seule chose qui fasse terminer l'extension : sans elle, une
+    /// suite d'échecs perpétuels rend un ply à chaque échec et la ligne ne se
+    /// referme jamais. Un test qui se contenterait de constater que la
+    /// recherche ne plante pas mesurerait la garde d'ardoise, qui est un filet
+    /// de sécurité, pas la borne.
+    #[test]
+    fn lextension_decheck_sarrete_a_la_borne() {
+        // Position en échec, relevée par exécution et non dérivée de tête :
+        // c'est `Board::default()` joué jusqu'à un échec.
+        let board = board("rnb1kbnr/pppp1ppp/8/4p3/6Pq/5P2/PPPPP2P/RNBQKBNR w KQkq - 1 3");
+        assert!(
+            !board.checkers().is_empty(),
+            "la position doit être en échec"
+        );
+
+        let mut s = search();
+        s.root_depth = 4;
+        let borne = CHECK_EXTENSION_MAX_PLY_FACTOR * 4;
+
+        assert!(s.extend_for_check(&board, 0), "au ply 0, on étend");
+        assert!(
+            s.extend_for_check(&board, borne - 1),
+            "juste sous la borne, on étend encore"
+        );
+        assert!(
+            !s.extend_for_check(&board, borne),
+            "À LA BORNE, ON N'ÉTEND PLUS : c'est ce qui fait terminer"
+        );
+        assert!(!s.extend_for_check(&board, borne + 1), "au-delà non plus");
+
+        // Et jamais hors échec, quelle que soit la profondeur restante.
+        let calme = Board::default();
+        assert!(calme.checkers().is_empty());
+        assert!(!s.extend_for_check(&calme, 0));
+    }
