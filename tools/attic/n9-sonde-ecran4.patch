+/// SONDE N9 — l'échange statique d'un coup TRANQUILLE : rien de pris, la
+/// pièce se pose sur `mv.to`, puis la suite de captures sur cette case, les
+/// deux camps pouvant s'arrêter à tout moment. Zéro si personne ne prend.
+#[must_use]
+pub fn see_quiet(board: &Board, mv: Move) -> i32 {
+    let Some(mover) = board.piece_on(mv.from) else {
+        return 0;
+    };
+    let target = mv.to;
+    let us = board.side_to_move();
+    let mut occupied = (board.occupied() ^ mv.from.bitboard()) | target.bitboard();
+    let mut gain = [0i32; MAX_SWAPS];
+    let mut on_target = value_on(mover, target, us);
+    let mut depth = 0;
+    let mut side = !us;
+    while let Some((from, piece)) = least_valuable_attacker(board, target, side, occupied) {
+        depth += 1;
+        if depth >= MAX_SWAPS {
+            break;
+        }
+        gain[depth] = on_target - gain[depth - 1];
+        occupied ^= from.bitboard();
+        on_target = value_on(piece, target, side);
+        side = !side;
+    }
+    while depth > 0 {
+        gain[depth - 1] = -((-gain[depth - 1]).max(gain[depth]));
+        depth -= 1;
+    }
+    gain[0]
+}
