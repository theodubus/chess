+/// SONDE N9 — vrai pendant une recherche singulière, puis pendant ProbCut :
+/// leurs nœuds ne se comptent qu'à la plus extérieure, l'union.
+static N9_SE_ACTIVE: AtomicBool = AtomicBool::new(false);
+static N9_PC_ACTIVE: AtomicBool = AtomicBool::new(false);
+
+/// SONDE N9 — l'échange statique des tranquilles, par profondeur 1 à 8 et
+/// par seau de 50 de la perte (0 : rien de perdu ; k ≥ 1 : perte dans
+/// `[50(k−1)+1, 50k]` ; le dernier, tout au-delà) : les tranquilles CHERCHÉS
+/// éligibles, et ceux qui montent alpha.
+pub const N9_SEEQ_BUCKETS: usize = 26;
+/// SONDE N9 — voir [`N9_SEEQ_BUCKETS`].
+pub static N9_SEEQ: [[[AtomicU64; 2]; N9_SEEQ_BUCKETS]; 9] =
+    [const { [const { [const { AtomicU64::new(0) }; 2] }; N9_SEEQ_BUCKETS] }; 9];
+fn n9_see_bucket(see: i32) -> usize {
+    if see >= 0 {
+        0
+    } else {
+        (((-see - 1) / 50) as usize + 1).min(N9_SEEQ_BUCKETS - 1)
+    }
+}
+
+/// SONDE N9 — la marge de ProbCut qui décide de l'éligibilité en ombre.
+const N9_PC_OMBRE: (i32, i32) = (200, 5);
+/// SONDE N9 — l'historique de correction : `2 × N9_CORR_SIZE` entrées, en
+/// unités d'évaluation × `N9_GRAIN`, bornées à ± `N9_CORR_MAX`.
+const N9_CORR_SIZE: usize = 1 << 14;
+const N9_GRAIN: i32 = 256;
+const N9_CORR_MAX: i32 = 256;
+const N9_CORR_DIFF_MAX: i32 = 512;
+/// SONDE N9 — la borne de l'historique des captures.
+const N9_CAPH_MAX: i32 = 16_384;
+
+/// SONDE N9 — l'index de la structure de pions, camp au trait compris.
+fn n9_pawn_index(board: &Board) -> usize {
+    let w = board.colored_pieces(Color::White, Piece::Pawn).0;
+    let b = board.colored_pieces(Color::Black, Piece::Pawn).0;
+    let h = (w.wrapping_mul(0x9E37_79B9_7F4A_7C15) ^ b.wrapping_mul(0xC2B2_AE3D_27D4_EB4F))
+        .wrapping_mul(0x1656_67B1_9E37_79F9);
+    board.side_to_move() as usize * N9_CORR_SIZE + (h >> 50) as usize
+}
+
+impl Search {
+    /// SONDE N9 — la correction de la structure de pions de `board`.
+    fn n9_corr_value(&self, board: &Board) -> i32 {
+        self.n9_corr.get(n9_pawn_index(board)).copied().unwrap_or(0) / N9_GRAIN
+    }
+
+    /// SONDE N9 — l'évaluation brute `raw`, corrigée par la variante `corr`.
+    fn n9_correct(&self, board: &Board, raw: i32) -> i32 {
+        if n9().corr {
+            (raw + self.n9_corr_value(board)).clamp(-(MATE_THRESHOLD - 1), MATE_THRESHOLD - 1)
+        } else {
+            raw
+        }
+    }
+
+    /// SONDE N9 — rapproche la correction de `diff = résultat − brute`,
+    /// d'autant plus que la recherche était profonde.
+    fn n9_corr_update(&mut self, board: &Board, diff: i32, depth: i32) {
+        let w = (depth + 1).clamp(1, 16);
+        let target = diff.clamp(-N9_CORR_DIFF_MAX, N9_CORR_DIFF_MAX) * N9_GRAIN;
+        if let Some(e) = self.n9_corr.get_mut(n9_pawn_index(board)) {
+            *e = ((*e * (256 - w) + target * w) / 256)
+                .clamp(-N9_CORR_MAX * N9_GRAIN, N9_CORR_MAX * N9_GRAIN);
+        }
+    }
+
+    /// SONDE N9 — l'index d'une capture dans l'historique des captures.
+    fn n9_caph_index(board: &Board, mv: Move, victim: Piece) -> usize {
+        piece_to(board, mv) * Piece::NUM + victim as usize
+    }
+
+    /// SONDE N9 — la note d'un coup tactique : MVV-LVA, ou avec `caph`, la
+    /// victime au poids `W` et l'historique des captures au lieu de
+    /// l'agresseur.
+    fn n9_tactical(&self, board: &Board, mv: Move) -> i32 {
+        let score = tactical_score(board, mv);
+        let (Some(w), Some(victim)) = (n9().caph, captured_piece(board, mv)) else {
+            return score;
+        };
+        let attacker = board
+            .piece_on(mv.from)
+            .map_or(0, |piece| ORDER_VALUE[piece as usize]);
+        let history = self
+            .n9_caph
+            .get(Self::n9_caph_index(board, mv, victim))
+            .copied()
+            .unwrap_or(0);
+        score - (1_000 * ORDER_VALUE[victim as usize] - attacker)
+            + w * ORDER_VALUE[victim as usize]
+            + history / 32
+    }
+
+    /// SONDE N9 — après une coupure : bonus à la capture qui coupe, malus
+    /// aux captures cherchées avant elle (à toutes si le coup qui coupe
+    /// n'est pas une capture).
+    fn n9_caph_update(&mut self, board: &Board, best: Move, tried: &[Move], depth: i32) {
+        let bonus = depth * depth;
+        for &mv in tried {
+            let Some(victim) = captured_piece(board, mv) else {
+                continue;
+            };
+            let b = if mv == best { bonus } else { -bonus };
+            if let Some(e) = self.n9_caph.get_mut(Self::n9_caph_index(board, mv, victim)) {
+                *e += b - *e * b.abs() / N9_CAPH_MAX;
+            }
+        }
+    }
+}
