+/// SONDE N9 v4 — variantes de MESURE, choisies par la variable
+/// d'environnement `N9`, combinables par « + » ; sans elle, `main` au nœud
+/// près :
+/// - `se:M:D` — extensions singulières, marge `M·profondeur`, dès la
+///   profondeur `D` ; `mc` y ajoute le multi-cut ;
+/// - `corr` — l'historique de correction de l'évaluation statique, par
+///   structure de pions, lu par la recherche et la quiescence ;
+/// - `caph` ou `caph:W` — l'historique des captures dans l'ordre des
+///   tactiques, la victime pesant `W` (1 000 par défaut : il ne départage que
+///   les captures d'une même victime) ;
+/// - `pc:M:D` — ProbCut, `bêta + M`, dès la profondeur `D` ;
+/// - `seeq:M:D` — l'échange statique des tranquilles : sauté s'il perd plus
+///   que `M·d²`, jusqu'à la profondeur `D`.
+#[derive(Default, Clone, Copy)]
+struct N9 {
+    se: Option<(i32, i32)>,
+    mc: bool,
+    corr: bool,
+    caph: Option<i32>,
+    pc: Option<(i32, i32)>,
+    seeq: Option<(i32, i32)>,
+}
+
+fn n9() -> N9 {
+    static V: std::sync::OnceLock<N9> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N9::default();
+        for part in std::env::var("N9").unwrap_or_default().split('+') {
+            let n: Vec<i32> = part.split(':').skip(1).filter_map(|x| x.parse().ok()).collect();
+            match (part.split(':').next().unwrap_or(""), &n[..]) {
+                ("se", [m, d]) => v.se = Some((*m, *d)),
+                ("mc", []) => v.mc = true,
+                ("corr", []) => v.corr = true,
+                ("caph", []) => v.caph = Some(1_000),
+                ("caph", [w]) => v.caph = Some(*w),
+                ("pc", [m, d]) => v.pc = Some((*m, *d)),
+                ("seeq", [m, d]) => v.seeq = Some((*m, *d)),
+                _ => {}
+            }
+        }
+        v
+    })
+}
