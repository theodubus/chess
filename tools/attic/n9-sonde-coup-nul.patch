+/// SONDE N9 — variantes de MESURE, choisies par la variable d'environnement
+/// `N9` : « gate » (coup nul seulement si l'évaluation statique atteint
+/// bêta), « r33 » / « r34 » (R = 3 + profondeur / 3 ou / 4), « iir »
+/// (profondeur − 1 sans coup de la table, à partir de 4) ; combinables par
+/// « + ». Sans elle, `main` au nœud près.
+#[derive(Default, Clone, Copy)]
+struct N9 {
+    gate: bool,
+    r_div: i32,
+    iir: bool,
+    imp_rfp: bool,
+    imp_lmp: bool,
+    imp_lmr: bool,
+    see_cap: bool,
+    /// La futilité aux nœuds frontières : `(a, b, dmax)`, marge `a + b·d`.
+    fp: Option<(i32, i32, i32)>,
+}
+
+fn v9_early() -> N9 {
+    n9()
+}
+
+fn n9() -> N9 {
+    static V: std::sync::OnceLock<N9> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N9::default();
+        for part in std::env::var("N9").unwrap_or_default().split('+') {
+            match part {
+                "gate" => v.gate = true,
+                "r33" => v.r_div = 3,
+                "r34" => v.r_div = 4,
+                "iir" => v.iir = true,
+                "imp-rfp" => v.imp_rfp = true,
+                "imp-lmp" => v.imp_lmp = true,
+                "imp-lmr" => v.imp_lmr = true,
+                "see-cap" => v.see_cap = true,
+                p if p.starts_with("fp:") => {
+                    let n: Vec<i32> = p[3..].split(':').filter_map(|x| x.parse().ok()).collect();
+                    if let [a, b, dmax] = n[..] {
+                        v.fp = Some((a, b, dmax));
+                    }
+                }
+                _ => {}
+            }
+        }
+        v
+    })
+}
+
+/// SONDE N9 — le coup nul : essais, coupures et nœuds dépensés, selon que
+/// l'évaluation statique atteint bêta (ge) ou non (lt).
+pub static SONDE_NM: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+/// SONDE N9 — les nœuds de profondeur ≥ 4 hors racine, et ceux sans coup de
+/// la table : ce que l'IIR toucherait.
+pub static SONDE_IIR: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+/// SONDE N9 — vrai pendant la recherche d'un coup nul : ses nœuds ne se
+/// comptent qu'au coup nul le plus extérieur, l'union et non la somme.
+static SONDE_NM_ACTIVE: AtomicBool = AtomicBool::new(false);
+/// SONDE N9 — nœuds hors échec évalués, et ceux où la position s'améliore.
+pub static SONDE_IMP: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+/// SONDE N9 — captures éligibles à l'élagage par échange statique, celles
+/// qu'il sauterait, et parmi elles celles qui, cherchées, montent alpha.
+pub static SONDE_SEE: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+/// SONDE N9 — la futilité aux nœuds frontières : par profondeur 1 à 6 et par
+/// seau de l'écart g = alpha − évaluation statique (0 : g < 0 ; k ≥ 1 :
+/// 50(k−1) ≤ g < 50k ; le dernier, tout au-delà), les tranquilles CHERCHÉS
+/// éligibles, et ceux qui montent alpha.
+pub const N9_FP_BUCKETS: usize = 26;
+/// SONDE N9 — les compteurs de la futilité aux nœuds frontières, par
+/// profondeur et par seau : voir [`N9_FP_BUCKETS`].
+pub static SONDE_FP: [[[AtomicU64; 2]; N9_FP_BUCKETS]; 7] =
+    [const { [const { [const { AtomicU64::new(0) }; 2] }; N9_FP_BUCKETS] }; 7];
+fn n9_fp_bucket(g: i32) -> usize {
+    if g < 0 {
+        0
+    } else {
+        ((g / 50) as usize + 1).min(N9_FP_BUCKETS - 1)
+    }
+}
