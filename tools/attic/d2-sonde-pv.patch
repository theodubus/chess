+++ b/tools/src/bin/d2_probe.rs
@@ -0,0 +1,81 @@
+//! Sonde D2 — jetable. Est-ce que l'élagage par compte de coups détruit ses
+//! montées d'`alpha` SUR l'épine de la variante principale ?
+//!
+//! D2 pose que PVS n'est pas un gain mais un habilitant : il crée la
+//! distinction PV / hors-PV, et les moteurs forts n'appliquent LMP qu'aux
+//! nœuds hors PV. Si les montées d'`alpha` que LMP détruit sont concentrées
+//! sur l'épine, le gatage les sauve presque toutes et D2 vaut un match. Si
+//! elles sont ailleurs, le gatage ne protège rien et D2 est clos sans match.
+//!
+//! **Compter les NŒUDS PV ne répondrait pas à la question.** L'épine est
+//! minuscule par construction — au plus un nœud par ply — donc sa part des
+//! nœuds est dérisoire quelle que soit la réponse. Ce qui compte est la part
+//! des DÉGÂTS qui s'y trouve, pas la part des nœuds.
+
+use std::io::BufRead;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use cozy_chess::Board;
+use shallowred::position::Position;
+use shallowred::search::{
+    D2_DESTROYED, D2_EVENTS, D2_NODES, Limits, Search,
+};
+
+fn main() {
+    let profondeur: u32 = std::env::args()
+        .nth(1)
+        .and_then(|a| a.parse().ok())
+        .unwrap_or(10);
+    let limite: usize = std::env::args()
+        .nth(2)
+        .and_then(|a| a.parse().ok())
+        .unwrap_or(400);
+
+    let stop = Arc::new(AtomicBool::new(false));
+    let mut search = Search::new(stop);
+    let limits = Limits {
+        depth: Some(profondeur),
+        ..Limits::default()
+    };
+
+    let mut positions = 0usize;
+    for line in std::io::stdin().lock().lines().map_while(Result::ok) {
+        if positions >= limite {
+            break;
+        }
+        let fen = line.split(';').next().unwrap_or("").trim();
+        let Ok(board) = fen.parse::<Board>() else {
+            continue;
+        };
+        positions += 1;
+        // Table vidée entre deux positions : sans cela la sonde mesurerait
+        // aussi l'histoire des positions précédentes.
+        search.clear_table();
+        let position = Position::from_board(board);
+        let _ = search.go(&position, &limits, |_| {});
+    }
+
+    let lire = |t: &[std::sync::atomic::AtomicU64; 2]| {
+        (t[0].load(Ordering::Relaxed), t[1].load(Ordering::Relaxed))
+    };
+    let (n_hors, n_pv) = lire(&D2_NODES);
+    let (e_hors, e_pv) = lire(&D2_EVENTS);
+    let (d_hors, d_pv) = lire(&D2_DESTROYED);
+
+    let pct = |a: u64, b: u64| {
+        if b == 0 { 0.0 } else { 100.0 * a as f64 / b as f64 }
+    };
+
+    println!("positions                {positions}");
+    println!("profondeur               {profondeur}");
+    println!();
+    println!("                              hors PV            sur l'épine PV");
+    println!("nœuds                   {n_hors:>14}  {n_pv:>14}   ({:.4} % sur l'épine)", pct(n_pv, n_hors + n_pv));
+    println!("nœuds où LMP couperait  {e_hors:>14}  {e_pv:>14}   ({:.4} % sur l'épine)", pct(e_pv, e_hors + e_pv));
+    println!("montées d'alpha détruites {d_hors:>12}  {d_pv:>14}   ({:.4} % sur l'épine)", pct(d_pv, d_hors + d_pv));
+    println!();
+    println!("part des coupes qui détruisent une montée :");
+    println!("  hors PV        {:.2} %", pct(d_hors, e_hors));
+    println!("  sur l'épine    {:.2} %", pct(d_pv, e_pv));
+}
