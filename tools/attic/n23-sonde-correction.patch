@@ -2789,6 +2895,29 @@ const LMR_HISTORY_DIVISOR: i32 = 6_000;
 /// La réduction d'un tranquille, modulée par sa note : `note / diviseur`
 /// plis de moins, ou de plus si elle est négative ; jamais sous zéro, ni
 /// au point de sauter la profondeur restante.
+const N27_SIZE: usize = 32_768;
+#[derive(Clone, Copy)]
+struct N27 { on: bool, p: bool, m: bool, n: bool, c: bool, w: i32 }
+fn n27() -> N27 {
+    static V: std::sync::OnceLock<N27> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N27 { on: false, p: true, m: true, n: true, c: true, w: 100 };
+        for part in std::env::var("N27").unwrap_or_default().split('+').filter(|p| !p.is_empty()) {
+            let mut it = part.split(':');
+            let key = it.next().unwrap_or("");
+            let arg = it.next().unwrap_or("");
+            match key {
+                "on" => v.on = true,
+                "t" => { v.on = true; v.p = arg.contains('p'); v.m = arg.contains('m'); v.n = arg.contains('n'); v.c = arg.contains('c'); }
+                "w" => v.w = arg.parse().unwrap_or(100),
+                _ => panic!("N27 {part}"),
+            }
+        }
+        v
+    })
+}
+pub static N27C: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
 fn modulated_reduction(base: i32, note: i32, depth: i32) -> i32 {
     (base - note / LMR_HISTORY_DIVISOR).min(depth - 2).max(0)
 }
