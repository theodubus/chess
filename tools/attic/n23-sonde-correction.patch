     /// réseau sur les accumulateurs de ce ply quand il y en a un, sinon la
     /// faite main. Le seul point d'entrée de l'évaluation dans la recherche.
     fn static_eval(&self, board: &Board, ply: usize) -> i32 {
+        let raw = self.static_eval_raw(board, ply);
+        let p = n27();
+        if !p.on {
+            return raw;
+        }
+        let c = self.n27_correction(board, ply);
+        N27C[0].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        N27C[1].fetch_add(u64::from(c.unsigned_abs()), std::sync::atomic::Ordering::Relaxed);
+        (raw + c).clamp(-(MATE_THRESHOLD - 1), MATE_THRESHOLD - 1)
+    }
+
+    fn n27_keys(board: &Board) -> [usize; 4] {
+        let bb = |c: Color, pc: Piece| board.colored_pieces(c, pc).0;
+        let mix = |v: &[u64]| -> usize {
+            const K: [u64; 6] = [
+                0x9E37_79B9_7F4A_7C15,
+                0xC2B2_AE3D_27D4_EB4F,
+                0x1656_67B1_9E37_79F9,
+                0xD6E8_FEB8_6659_FD93,
+                0xA076_1D64_78BD_642F,
+                0xE703_7ED1_A0B4_28DB,
+            ];
+            let mut h = 0u64;
+            for (i, &b) in v.iter().enumerate() {
+                h ^= b.wrapping_mul(K[i]).rotate_left(i as u32 * 7);
+            }
+            (h.wrapping_mul(0x2545_F491_4F6C_DD1D) >> 49) as usize
+        };
+        let w = Color::White;
+        let b = Color::Black;
+        [
+            mix(&[bb(w, Piece::Pawn), bb(b, Piece::Pawn)]),
+            mix(&[bb(w, Piece::Knight), bb(w, Piece::Bishop), bb(b, Piece::Knight), bb(b, Piece::Bishop)]),
+            mix(&[bb(w, Piece::Knight), bb(w, Piece::Bishop), bb(w, Piece::Rook), bb(w, Piece::Queen), bb(w, Piece::King)]),
+            mix(&[bb(b, Piece::Knight), bb(b, Piece::Bishop), bb(b, Piece::Rook), bb(b, Piece::Queen), bb(b, Piece::King)]),
+        ]
+    }
+
+    fn n27_cont_index(&self, ply: usize) -> Option<usize> {
+        let m1 = self.moved.get(ply).copied().flatten()?;
+        let m2 = self.moved.get(ply.checked_sub(1)?).copied().flatten()?;
+        Some(m2 * PIECE_TO + m1)
+    }
+
+    fn n27_correction(&self, board: &Board, ply: usize) -> i32 {
+        let p = n27();
+        let us = board.side_to_move() as usize;
+        let [pk, mk, wk, bk] = Self::n27_keys(board);
+        let g = |v: &Vec<i16>, i: usize| i64::from(v.get(i).copied().unwrap_or(0));
+        let pcv = g(&self.n27_pawn, us * N27_SIZE + pk);
+        let micv = g(&self.n27_minor, us * N27_SIZE + mk);
+        let wn = g(&self.n27_np, us * N27_SIZE + wk);
+        let bn = g(&self.n27_np, (2 + us) * N27_SIZE + bk);
+        let cnt = self.n27_cont_index(ply).map_or(0, |i| g(&self.n27_cont, i));
+        let mut v = 0i64;
+        if p.p { v += 7685 * pcv; }
+        if p.m { v += 7495 * micv; }
+        if p.n { v += 9144 * (wn + bn); }
+        if p.c { v += 6469 * cnt; }
+        i32::try_from(v * i64::from(p.w) / 100 / 131_072).unwrap_or(0)
+    }
+
+    fn n27_update(&mut self, board: &Board, ply: usize, bonus: i32) {
+        let p = n27();
+        let us = board.side_to_move() as usize;
+        let [pk, mk, wk, bk] = Self::n27_keys(board);
+        let grav = |e: &mut i16, b: i32| {
+            let b = b.clamp(-1024, 1024);
+            let v = i32::from(*e);
+            *e = i16::try_from(v + b - v * b.abs() / 1024).unwrap_or(0);
+        };
+        if p.p && let Some(e) = self.n27_pawn.get_mut(us * N27_SIZE + pk) { grav(e, bonus * 111 / 128); }
+        if p.m && let Some(e) = self.n27_minor.get_mut(us * N27_SIZE + mk) { grav(e, bonus * 146 / 128); }
+        if p.n {
+            if let Some(e) = self.n27_np.get_mut(us * N27_SIZE + wk) { grav(e, bonus * 162 / 128); }
+            if let Some(e) = self.n27_np.get_mut((2 + us) * N27_SIZE + bk) { grav(e, bonus * 162 / 128); }
+        }
+        if p.c && let Some(i) = self.n27_cont_index(ply) && let Some(e) = self.n27_cont.get_mut(i) { grav(e, bonus * 143 / 128); }
+        N27C[2].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+
+    fn static_eval_raw(&self, board: &Board, ply: usize) -> i32 {
         let Some(network) = &self.network else {
             return eval::evaluate(board, &self.params);
         };
