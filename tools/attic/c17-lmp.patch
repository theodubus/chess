+        quiet: bool,
+        in_check: bool,
+        ply: usize,
+        depth: i32,
+        best: i32,
+        quiets_seen: usize,
+    ) -> bool {
+        #[cfg(test)]
+        if !self.late_move_pruning {
+            return false;
+        }
