+#!/usr/bin/env python3
+"""Somme les lignes de `rejouer.py` (une par flux) et rend les proportions de C23.
+
+  python3 tools/sonde-c23/rejouer.py <journal> <binaire sondé> 0 > f0.txt   # etc.
+  cat f*.txt | python3 tools/sonde-c23/sommer.py
+
+Compteurs, dans l'ordre de `SONDES` : contrôles de répétition intérieurs,
+répétitions intérieures, dont fausses (la seule occurrence est AVANT le dernier
+coup nul), les trois mêmes à l'horizon (depth <= 0, là où C22 place son test),
+nœuds intérieurs sous un coup nul, recherches de coup nul, fausses dues à deux
+coups nuls consécutifs (intérieur, horizon), recherches de coup nul à
+profondeur >= 7, coups nuls joués juste après un coup nul.
+"""
+import sys
+t = [0] * 12
+for ligne in sys.stdin:
+    v = list(map(int, ligne.split()[2:]))
+    t = [a + b for a, b in zip(t, v)]
+print(f"répétitions intérieures : {t[1]}, fausses {t[2]} ({t[2]/max(t[1],1):.1%}), "
+      f"dont deux coups nuls consécutifs {t[8]} ({t[8]/max(t[2],1):.1%})")
+print(f"répétitions à l'horizon : {t[4]}, fausses {t[5]} ({t[5]/max(t[4],1):.1%}), "
+      f"dont deux coups nuls consécutifs {t[9]} ({t[9]/max(t[5],1):.1%})")
+print(f"fausses intérieures par nœud intérieur : {t[2]/max(t[0],1):.3%}")
+print(f"coups nuls joués juste après un coup nul : {t[11]/max(t[7],1):.1%} des recherches de coup nul")
