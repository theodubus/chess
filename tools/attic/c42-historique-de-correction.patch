+/// L'index de la structure de pions de `board` dans l'historique de
+/// correction, camp au trait compris. Les pions des deux camps, mêlés par
+/// multiplication : une table de 16 384 entrées par camp n'a pas besoin d'une
+/// clé de Zobrist, seulement d'un mélange — `cozy-chess` n'en tient pas pour
+/// les pions.
+fn pawn_index(board: &Board) -> usize {
+    let white = board.colored_pieces(Color::White, Piece::Pawn).0;
+    let black = board.colored_pieces(Color::Black, Piece::Pawn).0;
+    let mixed = (white.wrapping_mul(0x9E37_79B9_7F4A_7C15)
+        ^ black.wrapping_mul(0xC2B2_AE3D_27D4_EB4F))
+    .wrapping_mul(0x1656_67B1_9E37_79F9);
+    // Les quatorze bits du haut, les mieux mêlés : `CORRECTION_SIZE` vaut 2¹⁴.
+    board.side_to_move() as usize * CORRECTION_SIZE + (mixed >> 50) as usize
+}
+
+/// L'évaluation brute `raw` plus la correction `correction` — jamais un mat :
+/// une évaluation n'en annonce pas, réseau, faite main ou corrigée.
+fn corrected(raw: i32, correction: i32) -> i32 {
+    (raw + correction).clamp(-(MATE_THRESHOLD - 1), MATE_THRESHOLD - 1)
+}
+
+/// Un pas de la moyenne mobile de l'historique de correction : l'entrée
+/// `entry` se rapproche de l'écart `diff`, borné à ±
+/// [`CORRECTION_DIFF_MAX`], d'un poids `(depth + 1) / 256` — seize au plus —,
+/// puis se borne à ± [`CORRECTION_MAX`]. Une recherche profonde dit plus de
+/// la position qu'une recherche courte, d'où le poids.
+fn correction_step(entry: i32, diff: i32, depth: i32) -> i32 {
+    let weight = (depth + 1).clamp(1, 16);
+    let target = diff.clamp(-CORRECTION_DIFF_MAX, CORRECTION_DIFF_MAX) * CORRECTION_GRAIN;
+    ((entry * (256 - weight) + target * weight) / 256).clamp(
+        -CORRECTION_MAX * CORRECTION_GRAIN,
+        CORRECTION_MAX * CORRECTION_GRAIN,
+    )
+}
+
+/// Vrai si un résultat de recherche `best`, de borne `bound`, dit dans quel
+/// sens l'évaluation `estimate` se trompe : toujours s'il est exact ; une
+/// borne basse seulement au-dessus de l'estimation, une borne haute seulement
+/// en dessous. Une borne basse SOUS l'estimation ne dit rien : la vraie valeur
+/// peut être n'importe où au-dessus.
+///
+/// **Pourquoi l'historique de correction (C42)** : l'évaluation statique se
+/// trompe dans un sens qui tient à la structure de pions, et ce biais
+/// persiste d'un nœud à l'autre. Mesuré le 6 oct. 2026, rejeu de 6 203
+/// positions de parties du moteur qui joue, profondeur 12 : la correction
+/// connue à l'entrée d'un nœud ramène l'écart moyen au résultat de 81,2 à
+/// 75,2 unités, −7,4 % ; elle vaut 17 unités en moyenne. L'arbre grossit
+/// de 7,4 % — les élagages coupent moins quand l'évaluation cesse de se
+/// surestimer. **Une erreur de prédiction n'est pas une mesure de force**
+/// (`CLAUDE.md`, le précédent de Texel) : seul le match tranche.
+fn informs_correction(bound: Bound, best: i32, estimate: i32) -> bool {
+    match bound {
+        Bound::Exact => true,
+        Bound::Lower => best > estimate,
+        Bound::Upper => best < estimate,
+    }
+}
