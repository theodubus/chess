+    #[test]
+    fn la_correction_se_rapproche_de_l_ecart_selon_la_profondeur() {
+        // Valeurs relevées sur la formule : poids (d + 1) / 256, seize au plus.
+        assert_eq!(correction_step(0, 100, 0), 100);
+        assert_eq!(correction_step(0, 100, 15), 1_600);
+        assert_eq!(correction_step(0, 100, 40), 1_600);
+        // Arrivée à l'écart, l'entrée ne bouge plus.
+        assert_eq!(correction_step(25_600, 100, 7), 25_600);
+        // L'écart se borne, puis l'entrée, dans les deux sens.
+        assert_eq!(
+            correction_step(0, 10_000, 15),
+            correction_step(0, CORRECTION_DIFF_MAX, 15)
+        );
+        let (mut haut, mut bas) = (0, 0);
+        for _ in 0..1_000 {
+            haut = correction_step(haut, 10_000, 15);
+            bas = correction_step(bas, -10_000, 15);
+        }
+        assert_eq!(haut, CORRECTION_MAX * CORRECTION_GRAIN);
+        assert_eq!(bas, -CORRECTION_MAX * CORRECTION_GRAIN);
+    }
