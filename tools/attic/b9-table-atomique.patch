+const SCORE_SHIFT: u32 = 0;
+const MV_SHIFT: u32 = 16;
+const DEPTH_SHIFT: u32 = 32;
+const BOUND_SHIFT: u32 = 40;
+const GEN_SHIFT: u32 = 42;
