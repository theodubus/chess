+    #[test]
+    fn le_cache_ne_recompte_que_les_pieces_qui_ont_change() {
+        // Le roi blanc passe de d1 à e1 : il change de côté, donc de bloc, et
+        // son camp se recalcule — trois fois, chaque fois repris du cache.
+        // Le résultat seul ne distingue pas un cache servi d'un cache ignoré,
+        // ni un cache qui retient de travers : le compte des lignes, si.
+        let values = random_values_with(BUCKETED, 31, 150, 127);
+        let network = Network::from_bytes_with(&file_of_any(&values), BUCKETED).unwrap();
+        let mut cache = network.refresh_cache();
+        let rows_for = |cache: &mut RefreshCache, fen: &str| {
+            let position = board(fen);
+            let mv = cozy_chess::util::parse_uci_move(&position, "d1e1").unwrap();
+            let before = network.refresh(&position);
+            let mut after = before;
+            CACHED_ROWS.with(|count| count.set(0));
+            network.apply_move(&before, &mut after, &position, mv, cache);
+            let mut child = position.clone();
+            child.play_unchecked(mv);
+            assert_eq!(after, network.refresh(&child), "{fen}");
+            CACHED_ROWS.with(std::cell::Cell::get)
+        };
+        let start = "4k3/pppppppp/8/8/8/8/PPPPPPPP/3K4 w - - 0 1";
+        // Neuf, le bloc vaut l'échiquier vide : une ligne par pièce.
+        assert_eq!(rows_for(&mut cache, start), 18);
+        // La même position : rien à ajouter ni à retirer.
+        assert_eq!(rows_for(&mut cache, start), 0);
+        // Un pion noir de plus avancé, un pion blanc de moins : une ligne
+        // retirée et une ajoutée pour le premier, une retirée pour le second.
+        assert_eq!(
+            rows_for(&mut cache, "4k3/1ppppppp/p7/8/8/8/1PPPPPPP/3K4 w - - 0 1"),
+            3
+        );
+    }
