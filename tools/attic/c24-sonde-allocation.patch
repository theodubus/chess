diff --git a/tools/sonde-alloc/analyser.py b/tools/sonde-alloc/analyser.py
new file mode 100644
index 0000000..e026398
--- /dev/null
+++ b/tools/sonde-alloc/analyser.py
@@ -0,0 +1,507 @@
+#!/usr/bin/env python3
+"""Lecteur de la sonde de l'allocation inégale (`alloc-probe`).
+
+Chaque ligne JSON est un coup d'une vraie partie : la trace de la recherche
+PROLONGÉE (jusqu'à `mult` × budget, depuis une copie de la table) et celle de
+la recherche NORMALE qui a joué. Une itération est
+`[profondeur, instant_ms, coup, cp, nœuds, effort_pour_mille]`.
+
+Ce que le lecteur rend, dans l'ordre :
+
+1. la cohérence : la règle actuelle, simulée sur la trace prolongée, rend-elle
+   le coup que la recherche normale a joué ?
+2. la comptabilité du temps de la règle actuelle : arrêts par l'échéance douce
+   ou dure, et le temps JETÉ dans les itérations interrompues ;
+3. la courbe d'accord avec l'oracle — la décision au bout de la trace
+   prolongée — quand on multiplie le budget uniformément : c'est l'étalon qui
+   convertit un gain d'accord en temps équivalent ;
+4. par classe de position au moment où la règle actuelle décide : ce que
+   coûte un demi-budget, ce que rapporte un double budget ;
+5. une règle INÉGALE — poursuivre tant que la probabilité qu'une itération de
+   plus change le coup, rapportée à son coût, dépasse un seuil —, apprise sur
+   une moitié des parties et évaluée sur l'autre, à temps total égal.
+6. C24 tel qu'écrit — douce à 0,44 budget, dure à 2,2 budgets bornée par la
+   pendule — contre la règle actuelle, coup par coup : PROFONDEUR achevée,
+   temps, accord. C'est l'attendu de la sonde en partie, calculé au lieu
+   d'être dérivé de tête.
+7. C25 — une douce par classe de stabilité, proportionnelle à la probabilité
+   qu'une itération de plus change le coup, par-dessus C24 : les constantes,
+   calibrées au temps moyen de C24, et le supplément sur C24 en plis
+   d'accord, appris sur une moitié des parties et évalué sur l'autre, avec
+   le témoin « douce plate, dure 3 budgets ».
+
+Usage : analyser.py fichier.jsonl [...]
+"""
+import json
+import math
+import random
+import sys
+from collections import defaultdict
+
+PLIS_PAR_DOUBLEMENT = 1.38  # étalon du 24 sept. 2026, ± 0,28
+ELO_PAR_PLI = (60, 105)  # étalon du 24 sept. 2026, bornes croisées
+MATE = 20_000
+
+
+def charger(chemins):
+    coups = []
+    for chemin in chemins:
+        with open(chemin, encoding="utf-8") as f:
+            for ligne in f:
+                ligne = ligne.strip()
+                if not ligne:
+                    continue
+                try:
+                    coups.append(json.loads(ligne))
+                except json.JSONDecodeError:
+                    pass  # ligne tronquée par un arrêt en cours de partie
+    return [c for c in coups if c["ext"]]
+
+
+def simuler(ext, douce, dure):
+    """La règle actuelle : pas d'itération entamée après `douce`, abandon à
+    `dure`. Rend (indice de la dernière itération achevée, temps dépensé,
+    cause, temps jeté)."""
+    dernier, t_prec = None, 0
+    for i, it in enumerate(ext):
+        if dernier is not None and t_prec >= douce:
+            return dernier, t_prec, "douce", 0
+        if it[1] > dure:
+            return dernier, dure, "dure", dure - t_prec
+        dernier, t_prec = i, it[1]
+    if abs(ext[-1][3]) > MATE:  # mat trouvé : la recherche s'arrête d'elle-même
+        return dernier, t_prec, "fin", 0
+    # La trace s'arrête à l'horizon : l'itération suivante n'y a pas fini.
+    if t_prec >= douce:
+        return dernier, t_prec, "douce", 0
+    return dernier, dure, "dure", dure - t_prec
+
+
+def simuler_prudente(ext, douce, dure, rho):
+    """La règle plate, sans gaspillage : en plus de l'échéance douce, elle
+    n'entame pas une itération dont la fin prévue — `rho` fois l'instant
+    présent — tomberait après la dure. Rend (indice, temps, temps jeté)."""
+    dernier, t_prec = None, 0
+    for i, it in enumerate(ext):
+        if dernier is not None and (t_prec >= douce or t_prec * rho > dure):
+            return dernier, t_prec, 0
+        if it[1] > dure:
+            return dernier, dure, dure - t_prec
+        dernier, t_prec = i, it[1]
+    if abs(ext[-1][3]) > MATE or t_prec >= douce or t_prec * rho > dure:
+        return dernier, t_prec, 0
+    return dernier, dure, dure - t_prec
+
+
+def evaluer_prudente(coups, m, fraction_douce, rho):
+    accord, temps, jete = 0, 0, 0
+    for c in coups:
+        b = c["budget"] * m
+        i, t, j = simuler_prudente(c["ext"], b * fraction_douce, b, rho)
+        if i is not None and c["ext"][i][2] == c["ext"][-1][2]:
+            accord += 1
+        temps += t
+        jete += j
+    total = sum(c["budget"] for c in coups)
+    return accord / len(coups), temps / total, jete / max(temps, 1)
+
+
+def ajuster_m(coups, fraction_douce, rho, cible):
+    lo, hi = 0.2, 6.0
+    for _ in range(50):
+        mid = (lo + hi) / 2
+        if evaluer_prudente(coups, mid, fraction_douce, rho)[1] > cible:
+            hi = mid
+        else:
+            lo = mid
+    return (lo + hi) / 2
+
+
+def stabilite(ext, i):
+    k = 1
+    while i - k >= 0 and ext[i - k][2] == ext[i][2]:
+        k += 1
+    return k
+
+
+def classe_stabilite(k):
+    return "vient de changer" if k == 1 else "2-3" if k <= 3 else "4-6" if k <= 6 else "7+"
+
+
+def classe_effort(e):
+    return "<50 %" if e < 500 else "50-80 %" if e < 800 else "80-95 %" if e < 950 else "≥95 %"
+
+
+def croissance(coups):
+    """Rapport médian entre les instants de fin de deux itérations successives,
+    au-delà de 20 ms (le bruit d'horloge domine en dessous)."""
+    rapports = sorted(
+        c["ext"][i][1] / c["ext"][i - 1][1]
+        for c in coups
+        for i in range(1, len(c["ext"]))
+        if c["ext"][i - 1][1] >= 20
+    )
+    return rapports[len(rapports) // 2] if rapports else 2.0
+
+
+def courbe_plate(coups, mults):
+    """Accord avec l'oracle et temps total, budget multiplié uniformément."""
+    out = []
+    budget_total = sum(c["budget"] for c in coups)
+    for m in mults:
+        accord, temps = 0, 0
+        for c in coups:
+            b = c["budget"] * m
+            i, t, _, _ = simuler(c["ext"], b / 2, b)
+            if i is not None and c["ext"][i][2] == c["ext"][-1][2]:
+                accord += 1
+            temps += t
+        out.append((m, accord / len(coups), temps / budget_total))
+    return out
+
+
+def interpoler_temps(courbe, accord):
+    """Le temps relatif auquel la règle plate atteint `accord` (interpolation
+    en log du temps)."""
+    for (m0, a0, t0), (m1, a1, t1) in zip(courbe, courbe[1:]):
+        if a0 <= accord <= a1 and a1 > a0:
+            x = (accord - a0) / (a1 - a0)
+            return math.exp(math.log(t0) + x * (math.log(t1) - math.log(t0)))
+    return None
+
+
+def cle_2d(ext, i):
+    return (classe_stabilite(stabilite(ext, i)), classe_effort(ext[i][5]))
+
+
+def cle_stabilite(ext, i):
+    return (classe_stabilite(stabilite(ext, i)),)
+
+
+def table_changement(coups, cle=cle_2d, effectifs=False):
+    """P(l'itération suivante change le coup | classe), comptée sur toutes les
+    itérations des traces prolongées."""
+    n = defaultdict(lambda: [0, 0])
+    for c in coups:
+        ext = c["ext"]
+        for i in range(len(ext) - 1):
+            k = cle(ext, i)
+            n[k][0] += 1
+            n[k][1] += ext[i + 1][2] != ext[i][2]
+    table = {k: (chg + 1) / (tot + 2) for k, (tot, chg) in n.items()}  # Laplace
+    return (table, dict(n)) if effectifs else table
+
+
+def regle_inegale(c, table, lam, rho, plafond, cle=cle_2d):
+    """Poursuit tant que P(changement) / coût relatif de l'itération suivante
+    ≥ `lam`, sans entamer une itération qui ne finirait pas avant la dure."""
+    ext, b = c["ext"], c["budget"]
+    dure = plafond * b
+    if c["legal"] == 1:
+        return 0, ext[0][1], 0
+    for i, it in enumerate(ext):
+        if it[1] > dure:  # ne devrait pas arriver : on n'entame pas ce qui déborde
+            return i - 1, dure, dure - ext[i - 1][1]
+        t = max(it[1], 1)
+        cout = t * (rho - 1) / b
+        p = table.get(cle(ext, i), 0.1)
+        if t * rho > dure or p / max(cout, 1e-6) < lam:
+            return i, it[1], 0
+    return len(ext) - 1, ext[-1][1], 0
+
+
+def evaluer(coups, table, lam, rho, plafond, cle=cle_2d):
+    accord, temps = 0, 0
+    for c in coups:
+        i, t, _ = regle_inegale(c, table, lam, rho, plafond, cle)
+        if c["ext"][i][2] == c["ext"][-1][2]:
+            accord += 1
+        temps += t
+    return accord / len(coups), temps / sum(c["budget"] for c in coups)
+
+
+def ajuster_lambda(coups, table, rho, plafond, cible, cle=cle_2d):
+    lo, hi = 1e-4, 1e4
+    for _ in range(60):
+        mid = math.sqrt(lo * hi)
+        _, t = evaluer(coups, table, mid, rho, plafond, cle)
+        if t > cible:
+            lo = mid
+        else:
+            hi = mid
+    return math.sqrt(lo * hi)
+
+
+def main():
+    coups = charger(sys.argv[1:])
+    parties = sorted({c["game"] for c in coups})
+    print(f"{len(coups)} coups, {len(parties)} parties")
+    if not coups:
+        return
+    rho = croissance(coups)
+    print(f"croissance médiane d'une itération à la suivante : × {rho:.2f}")
+
+    # 1. Cohérence.
+    ok = sum(
+        1
+        for c in coups
+        if (i := simuler(c["ext"], c["budget"] / 2, c["budget"])[0]) is not None
+        and c["ext"][i][2] == c["played"]
+    )
+    print(f"\n1. la règle simulée rend le coup joué : {ok}/{len(coups)} ({100 * ok / len(coups):.1f} %)")
+
+    # 2. Comptabilité du temps de la règle actuelle.
+    causes, jete, depense = defaultdict(int), 0, 0
+    for c in coups:
+        _, t, cause, j = simuler(c["ext"], c["budget"] / 2, c["budget"])
+        causes[cause] += 1
+        jete += j
+        depense += t
+    budget_total = sum(c["budget"] for c in coups)
+    reel = sum(c["used"] for c in coups)
+    print("\n2. comptabilité du temps, règle actuelle (douce = budget/2, dure = budget)")
+    print(f"   temps dépensé / budget : {depense / budget_total:.3f} simulé, {reel / budget_total:.3f} réel")
+    print("   arrêts : " + ", ".join(f"{k} {100 * v / len(coups):.1f} %" for k, v in sorted(causes.items())))
+    print(f"   temps JETÉ dans les itérations interrompues : {100 * jete / depense:.1f} % du temps dépensé")
+
+    # 3. Courbe plate.
+    mults = [0.25, 0.35, 0.5, 0.71, 1.0, 1.41, 2.0, 2.83]
+    courbe = courbe_plate(coups, mults)
+    print("\n3. budget multiplié uniformément — accord avec l'oracle (décision au bout de la trace prolongée)")
+    for m, a, t in courbe:
+        print(f"   × {m:<5} accord {100 * a:5.1f} %   temps dépensé / budget {t:.3f}")
+
+    # 4. Par classe, au moment où la règle actuelle décide.
+    print("\n4. par classe, au moment où la règle actuelle décide")
+    par = defaultdict(lambda: [0, 0, 0, 0])
+    for c in coups:
+        b = c["budget"]
+        i1 = simuler(c["ext"], b / 2, b)[0]
+        if i1 is None:
+            continue
+        i2 = simuler(c["ext"], b, 2 * b)[0]
+        i05 = simuler(c["ext"], b / 4, b / 2)[0]
+        ext = c["ext"]
+        cles = [
+            "tous",
+            "stabilité " + classe_stabilite(stabilite(ext, i1)),
+            "effort " + classe_effort(ext[i1][5]),
+            "un seul coup légal" if c["legal"] == 1 else "plusieurs coups légaux",
+        ]
+        if i1 > 0 and ext[i1][3] - ext[i1 - 1][3] <= -50 and abs(ext[i1][3]) < MATE:
+            cles.append("score en chute de 50 cp ou plus")
+        for cle in cles:
+            v = par[cle]
+            v[0] += 1
+            v[1] += i2 is not None and ext[i2][2] != ext[i1][2]
+            v[2] += i05 is None or ext[i05][2] != ext[i1][2]
+            v[3] += ext[i1][2] != ext[-1][2]
+    print(f"   {'classe':34} {'part':>7} {'×2 change':>10} {'×½ change':>10} {'≠ oracle':>9}")
+    for cle, (n, d2, d05, dor) in sorted(par.items(), key=lambda kv: -kv[1][0]):
+        print(f"   {cle:34} {100 * n / len(coups):6.1f}% {100 * d2 / n:9.1f}% {100 * d05 / n:9.1f}% {100 * dor / n:8.1f}%")
+
+    # 5 bis. Règle plate sans gaspillage, au même temps total.
+    print("\n5 bis. règle PLATE sans gaspillage — n'entame pas une itération promise à l'abandon ; même temps total")
+    cible = next(t for m, _, t in courbe if m == 1.0)
+    a_plate = next(a for m, a, _ in courbe if m == 1.0)
+    for fraction_douce in (0.5,):
+        for rho_prevu in (2.0, 2.5, 3.0, 3.5, 4.0, 5.0):
+            m = ajuster_m(coups, fraction_douce, rho_prevu, cible)
+            a, t, j = evaluer_prudente(coups, m, fraction_douce, rho_prevu)
+            t_eq = interpoler_temps(courbe, a)
+            gain = f"× {t_eq / t:.2f} de temps plat, {PLIS_PAR_DOUBLEMENT * math.log2(t_eq / t):+.2f} pli" if t_eq else "hors courbe"
+            douce_eff = min(fraction_douce, 1 / rho_prevu) * m
+            print(
+                f"   dure / douce = {rho_prevu} : douce {douce_eff:.2f} × budget, dure {m:.2f} × budget ; accord {100 * a:.1f} % "
+                f"(actuelle {100 * a_plate:.1f} %), jeté {100 * j:.1f} % — {gain}"
+            )
+
+    # 5. Règle inégale, apprise sur une moitié, évaluée sur l'autre.
+    print("\n5. règle inégale — apprise sur une moitié des parties, évaluée sur l'autre, à temps égal")
+    table, eff = table_changement(coups, cle_2d, effectifs=True)
+    print("   P(l'itération suivante change le coup), toutes parties — stabilité × effort (effectif) :")
+    efforts = ["<50 %", "50-80 %", "80-95 %", "≥95 %"]
+    print("   " + " " * 18 + "".join(f"{e:>16}" for e in efforts))
+    for st in ["vient de changer", "2-3", "4-6", "7+"]:
+        cells = []
+        for e in efforts:
+            k = (st, e)
+            cells.append(f"{100 * table[k]:5.1f} % ({eff[k][0]:>5})" if k in eff else " " * 16)
+        print(f"   {st:18}" + "".join(f"{c:>16}" for c in cells))
+    graine = random.Random(20260924)
+    melange = parties[:]
+    graine.shuffle(melange)
+    moitie = set(melange[: len(melange) // 2])
+    moities = [
+        ("A → B", [c for c in coups if c["game"] in moitie], [c for c in coups if c["game"] not in moitie]),
+        ("B → A", [c for c in coups if c["game"] not in moitie], [c for c in coups if c["game"] in moitie]),
+    ]
+    for nom_cle, cle in (("stabilité × effort", cle_2d), ("stabilité seule", cle_stabilite)):
+        for plafond in (2.0, 3.0):
+            for nom, app, test in moities:
+                if not app or not test:
+                    continue
+                tab = table_changement(app, cle)
+                cible = courbe_plate(app, [1.0])[0][2]
+                lam = ajuster_lambda(app, tab, rho, plafond, cible, cle)
+                a, t = evaluer(test, tab, lam, rho, plafond, cle)
+                courbe_test = courbe_plate(test, mults)
+                a_plate = next(a for m, a, _ in courbe_test if m == 1.0)
+                t_eq = interpoler_temps(courbe_test, a)
+                if t_eq is None:
+                    print(f"   {nom_cle}, dure {plafond} × budget, {nom} : hors de la courbe")
+                    continue
+                gain = t_eq / t
+                plis = PLIS_PAR_DOUBLEMENT * math.log2(gain)
+                # Intervalle : rééchantillonnage des parties du jeu d'évaluation.
+                par_partie = defaultdict(list)
+                for c in test:
+                    par_partie[c["game"]].append(c)
+                ids = list(par_partie)
+                tirages = []
+                rng = random.Random(7)
+                for _ in range(100):
+                    echantillon = [c for g in (rng.choice(ids) for _ in ids) for c in par_partie[g]]
+                    ab, tb = evaluer(echantillon, tab, lam, rho, plafond, cle)
+                    teb = interpoler_temps(courbe_plate(echantillon, mults), ab)
+                    if teb:
+                        tirages.append(PLIS_PAR_DOUBLEMENT * math.log2(teb / tb))
+                tirages.sort()
+                ic = f"[{tirages[2]:+.2f} ; {tirages[-3]:+.2f}]" if len(tirages) >= 50 else "—"
+                print(
+                    f"   {nom_cle}, dure {plafond} × budget, {nom} : accord {100 * a:.1f} % contre {100 * a_plate:.1f} % à plat, "
+                    f"temps {t:.3f} ; × {gain:.2f} de temps plat, {plis:+.2f} pli, IC 95 % {ic}"
+                )
+
+    # 6. C24 tel qu'écrit, coup par coup contre la règle actuelle.
+    print("\n6. C24 tel qu'écrit (douce 0,44 budget, dure min(2,2 budgets, restant − 50)) contre la règle actuelle")
+    paires = []
+    for c in coups:
+        b = c["budget"]
+        i0, t0, cause0, _ = simuler(c["ext"], b / 2, b)
+        i1, t1, cause1, _ = simuler(c["ext"], 0.44 * b, max(1, min(2.2 * b, c["remaining"] - 50)))
+        if i0 is None or i1 is None:
+            continue
+        paires.append((c, i0, t0, cause0, i1, t1, cause1))
+    n = len(paires)
+    for nom, k in (("actuelle", 1), ("C24", 4)):
+        prof = sum(p[0]["ext"][p[k]][0] for p in paires) / n
+        temps = sum(p[k + 1] for p in paires) / sum(p[0]["budget"] for p in paires)
+        ms = sum(p[k + 1] for p in paires) / n
+        dure = sum(p[k + 2] == "dure" for p in paires) / n
+        acc = sum(p[0]["ext"][p[k]][2] == p[0]["ext"][-1][2] for p in paires) / n
+        print(f"   {nom:8} profondeur achevée {prof:.3f}, temps / budget {temps:.3f} ({ms:.1f} ms), "
+              f"arrêts par la dure {100 * dure:.1f} %, accord {100 * acc:.1f} %")
+    ecarts = defaultdict(list)
+    compte = defaultdict(int)
+    for c, i0, _, _, i1, _, _ in paires:
+        d = c["ext"][i1][0] - c["ext"][i0][0]
+        ecarts[c["game"]].append(d)
+        compte[d] += 1
+    moyenne = sum(sum(v) for v in ecarts.values()) / n
+    ids = list(ecarts)
+    rng = random.Random(11)
+    tirages = []
+    for _ in range(2000):
+        tir = [ecarts[rng.choice(ids)] for _ in ids]
+        tirages.append(sum(map(sum, tir)) / sum(map(len, tir)))
+    tirages.sort()
+    print(f"   écart de profondeur apparié {moyenne:+.3f} pli, IC 95 % [{tirages[49]:+.3f} ; {tirages[1949]:+.3f}] "
+          f"(rééchantillonnage des parties) — " + ", ".join(f"{d:+d} : {v}" for d, v in sorted(compte.items())))
+
+
+    # 7. C25 : une douce par classe de stabilité, par-dessus C24.
+    print("\n7. C25 — douce par classe de stabilité, calibrée au temps moyen de C24 ; supplément sur C24")
+    classes = ["vient de changer", "2-3", "4-6", "7+"]
+
+    def c25(c, mult, dure_f):
+        ext, b = c["ext"], c["budget"]
+        dure = max(1, min(dure_f * b, c["remaining"] - 50))
+        dernier, t = None, 0
+        for i, it in enumerate(ext):
+            if dernier is not None and t >= b * mult[classe_stabilite(stabilite(ext, dernier))]:
+                return dernier, t
+            if it[1] > dure:
+                return dernier, dure
+            dernier, t = i, it[1]
+        if abs(ext[-1][3]) > MATE or t >= b * mult[classe_stabilite(stabilite(ext, dernier))]:
+            return dernier, t
+        return dernier, dure
+
+    def eval_c25(ens, mult, dure_f):
+        acc = tps = 0
+        for c in ens:
+            i, t = c25(c, mult, dure_f)
+            acc += i is not None and c["ext"][i][2] == c["ext"][-1][2]
+            tps += t
+        return acc / len(ens), tps / sum(c["budget"] for c in ens)
+
+    plate = {k: 0.44 for k in classes}
+
+    def calibrer(ens, proba, dure_f, cible):
+        lo, hi = 0.01, 50.0
+        for _ in range(60):
+            k = (lo + hi) / 2
+            if eval_c25(ens, {c: k * proba[c] for c in classes}, dure_f)[1] > cible:
+                hi = k
+            else:
+                lo = k
+        return (lo + hi) / 2
+
+    def calibrer_plate(ens, dure_f, cible):
+        lo, hi = 0.05, 2.0
+        for _ in range(50):
+            k = (lo + hi) / 2
+            if eval_c25(ens, {c: k for c in classes}, dure_f)[1] > cible:
+                hi = k
+            else:
+                lo = k
+        return (lo + hi) / 2
+
+    def supplement(test, mult, dure_f):
+        a, t = eval_c25(test, mult, dure_f)
+        a0, t0 = eval_c25(test, plate, 2.2)
+        ct = courbe_plate(test, mults)
+        te, te0 = interpoler_temps(ct, a), interpoler_temps(ct, a0)
+        if not te or not te0:
+            return None
+        return PLIS_PAR_DOUBLEMENT * math.log2((te / t) / (te0 / t0))
+
+    proba = {k[0]: v for k, v in table_changement(coups, cle_stabilite).items()}
+    _, t24 = eval_c25(coups, plate, 2.2)
+    k_tout = calibrer(coups, proba, 3.0, t24)
+    permille = {c: round(1000 * k_tout * proba[c]) for c in classes}
+    print("   P(l'itération suivante change le coup) : " + ", ".join(f"{c} {100 * proba[c]:.1f} %" for c in classes))
+    print("   douces calibrées, dure 3 budgets, en pour mille du budget : " + ", ".join(f"{c} {permille[c]}" for c in classes))
+    arrondi = {c: permille[c] / 1000 for c in classes}
+    print(f"   dans l'échantillon : supplément {supplement(coups, arrondi, 3.0):+.2f} pli d'accord sur C24")
+    for variante in ("stabilité, dure 2,2", "stabilité, dure 3", "plate, dure 3"):
+        for nom, app, test in moities:
+            if not app or not test:
+                continue
+            cible = eval_c25(app, plate, 2.2)[1]
+            if variante.startswith("plate"):
+                k = calibrer_plate(app, 3.0, cible)
+                mult, dure_f = {c: k for c in classes}, 3.0
+            else:
+                dure_f = 2.2 if "2,2" in variante else 3.0
+                p_app = {k[0]: v for k, v in table_changement(app, cle_stabilite).items()}
+                k = calibrer(app, p_app, dure_f, cible)
+                mult = {c: k * p_app[c] for c in classes}
+            g = supplement(test, mult, dure_f)
+            par = defaultdict(list)
+            for c in test:
+                par[c["game"]].append(c)
+            ids = list(par)
+            rng = random.Random(7)
+            tirages = []
+            for _ in range(200):
+                ech = [c for gid in (rng.choice(ids) for _ in ids) for c in par[gid]]
+                x = supplement(ech, mult, dure_f)
+                if x is not None:
+                    tirages.append(x)
+            tirages.sort()
+            print(f"   {variante:20} {nom} : {g:+.2f} pli d'accord sur C24, IC 95 % [{tirages[4]:+.2f} ; {tirages[-5]:+.2f}]")
+
+if __name__ == "__main__":
+    main()
