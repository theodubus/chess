+++ b/tools/src/bin/alloc_probe.rs
@@ -0,0 +1,236 @@
+//! SONDE JETABLE — l'allocation inégale : où un surcroît de temps change-t-il
+//! la décision, et où un temps retiré ne coûte-t-il rien ?
+//!
+//! Vit dans sa rustine de l'attic, avec l'instrumentation qu'elle lit (copie
+//! de la table, effort à la racine) : jamais dans l'arbre.
+//!
+//! # Le régime
+//!
+//! Des parties entières, depuis le livre des matchs, pendule qui décroît,
+//! **une table par camp** comme en match — `b2_probe` en partageait une entre
+//! les deux camps. Chaque coup est joué par la recherche NORMALE, au budget
+//! que le moteur se donne : c'est elle qui fait avancer la partie et la table.
+//!
+//! # La mesure
+//!
+//! Avant chaque recherche normale, la table du camp au trait est copiée, puis
+//! une recherche PROLONGÉE jusqu'à `mult × budget` part de cette copie et
+//! rapporte chaque itération achevée : profondeur, instant, coup, score,
+//! effort à la racine. La table est ensuite rétablie, pour que la partie ne
+//! garde aucune trace de la recherche prolongée — sans quoi elle jouerait
+//! dans une table plus chaude que celle d'un match.
+//!
+//! La recherche prolongée avance exactement comme la normale jusqu'à ce que
+//! la normale s'arrête : même position, même table, mêmes nœuds. Toute règle
+//! d'arrêt se simule donc hors ligne sur sa trace — c'est le rôle de
+//! `tools/sonde-alloc/analyser.py`.
+//!
+//! Une recherche à l'horloge n'est pas déterministe : les chiffres
+//! appartiennent à leur machine, comme un étalonnage de runner.
+//!
+//! Usage : `alloc-probe <parties> <base_ms> <inc_ms> <premier_indice_du_livre> <livre.epd> <sortie.jsonl> [mult]`
+use std::fmt::Write as _;
+use std::io::Write as _;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+use cozy_chess::{Board, Color, Move};
+use shallowred::eval::is_insufficient_material;
+use shallowred::position::Position;
+use shallowred::search::{Info, Limits, Score, Search};
+
+/// La MÊME formule que `time_budget_ms`, `movestogo` à douze par défaut.
+fn budget_ms(remaining: u64, inc: u64) -> u64 {
+    (remaining / 12 + inc / 2).clamp(1, remaining.saturating_sub(50).max(1))
+}
+
+fn cp(score: Score) -> i32 {
+    match score {
+        Score::Cp(cp) => cp,
+        Score::Mate(m) if m > 0 => 30_000 - m,
+        Score::Mate(m) => -30_000 - m,
+    }
+}
+
+fn legal_count(board: &Board) -> usize {
+    let mut n = 0;
+    board.generate_moves(|set| {
+        n += set.len();
+        false
+    });
+    n
+}
+
+fn iteration_json(info: &Info) -> String {
+    let mv = info.pv.first().map_or_else(String::new, Move::to_string);
+    format!(
+        "[{},{},\"{}\",{},{},{}]",
+        info.depth,
+        info.time_ms,
+        mv,
+        cp(info.score),
+        info.nodes,
+        info.effort_permille
+    )
+}
+
+/// Une ligne EPD : les quatre premiers champs forment la FEN.
+fn epd_to_fen(line: &str) -> Option<String> {
+    let fields: Vec<&str> = line.split_whitespace().take(4).collect();
+    (fields.len() == 4).then(|| format!("{} 0 1", fields.join(" ")))
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let arg = |i: usize| args.get(i).map(String::as_str);
+    let games: usize = arg(0).and_then(|a| a.parse().ok()).unwrap_or(1);
+    let base: u64 = arg(1).and_then(|a| a.parse().ok()).unwrap_or(8_000);
+    let inc: u64 = arg(2).and_then(|a| a.parse().ok()).unwrap_or(80);
+    let first: usize = arg(3).and_then(|a| a.parse().ok()).unwrap_or(0);
+    let book = arg(4).unwrap_or("tools/book.epd");
+    let out = arg(5).unwrap_or("alloc.jsonl");
+    let mult: u64 = arg(6).and_then(|a| a.parse().ok()).unwrap_or(4);
+
+    let lines: Vec<String> = std::fs::read_to_string(book)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(epd_to_fen)
+        .collect();
+    if lines.is_empty() {
+        eprintln!("livre vide ou illisible : {book}");
+        std::process::exit(1);
+    }
+    let Ok(mut file) = std::fs::File::create(out) else {
+        eprintln!("sortie impossible : {out}");
+        std::process::exit(1);
+    };
+
+    for g in 0..games {
+        let Some(fen) = lines.get((first + g) % lines.len()) else {
+            continue;
+        };
+        let Ok(mut position) = Position::from_fen(fen) else {
+            continue;
+        };
+        // Une table par camp, comme en match.
+        let stops = [
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(AtomicBool::new(false)),
+        ];
+        let mut engines = [
+            Search::new(Arc::clone(&stops[0])),
+            Search::new(Arc::clone(&stops[1])),
+        ];
+        let mut clock = [base, base];
+        // Scores des recherches normales, du point de vue des Blancs, pour
+        // l'adjudication — la même que `match.yml`.
+        let mut white_scores: Vec<i32> = Vec::new();
+        let started = Instant::now();
+
+        for ply in 0..400usize {
+            let board = position.board().clone();
+            let legal = legal_count(&board);
+            if legal == 0
+                || position.is_repetition()
+                || position.is_fifty_move_draw()
+                || is_insufficient_material(&board)
+            {
+                break;
+            }
+            let side = board.side_to_move();
+            let s = usize::from(side == Color::Black);
+            let remaining = clock[s];
+            let budget = budget_ms(remaining, inc);
+
+            // La recherche prolongée, depuis une copie de la table.
+            let snapshot = engines[s].table().snapshot();
+            stops[s].store(false, Ordering::Relaxed);
+            let stop = Arc::clone(&stops[s]);
+            let horizon = budget * mult;
+            let timer = std::thread::spawn(move || {
+                std::thread::sleep(Duration::from_millis(horizon));
+                stop.store(true, Ordering::Relaxed);
+            });
+            let mut extended = String::new();
+            let infinite = Limits {
+                infinite: true,
+                ..Limits::default()
+            };
+            engines[s].go(&position, &infinite, |info| {
+                if !extended.is_empty() {
+                    extended.push(',');
+                }
+                extended.push_str(&iteration_json(info));
+            });
+            let _ = timer.join();
+            engines[s].table().restore(&snapshot);
+            stops[s].store(false, Ordering::Relaxed);
+
+            // La recherche normale, qui joue.
+            let limits = Limits {
+                wtime: Some(clock[0]),
+                btime: Some(clock[1]),
+                winc: Some(inc),
+                binc: Some(inc),
+                ..Limits::default()
+            };
+            let mut normal = String::new();
+            let mut last_cp = 0;
+            let start = Instant::now();
+            let played = engines[s].go(&position, &limits, |info| {
+                if !normal.is_empty() {
+                    normal.push(',');
+                }
+                normal.push_str(&iteration_json(info));
+                last_cp = cp(info.score);
+            });
+            let used = u64::try_from(start.elapsed().as_millis()).unwrap_or(u64::MAX);
+            let Some(mv) = played else { break };
+
+            let mut line = String::new();
+            let _ = write!(
+                line,
+                "{{\"game\":{},\"ply\":{},\"side\":\"{}\",\"remaining\":{},\"budget\":{},\"used\":{},\"legal\":{},\"played\":\"{}\",\"ext\":[{}],\"norm\":[{}]}}",
+                first + g,
+                ply,
+                if s == 0 { "w" } else { "b" },
+                remaining,
+                budget,
+                used,
+                legal,
+                mv,
+                extended,
+                normal
+            );
+            let _ = writeln!(file, "{line}");
+
+            if used >= remaining + inc {
+                eprintln!("partie {} : perte au temps au demi-coup {ply}", first + g);
+                break;
+            }
+            clock[s] = remaining + inc - used;
+            position.play(mv);
+
+            white_scores.push(if s == 0 { last_cp } else { -last_cp });
+            let n = white_scores.len();
+            // Abandon : quatre coups de chaque camp à 600 cp ou plus, même sens.
+            if n >= 8 {
+                let tail = &white_scores[n - 8..];
+                if tail.iter().all(|&v| v >= 600) || tail.iter().all(|&v| v <= -600) {
+                    break;
+                }
+            }
+            // Nulle : après le 40e coup, huit coups de chaque camp à 10 cp ou moins.
+            if ply >= 80 && n >= 16 && white_scores[n - 16..].iter().all(|&v| v.abs() <= 10) {
+                break;
+            }
+        }
+        let _ = file.flush();
+        eprintln!(
+            "partie {} finie en {:.0} s",
+            first + g,
+            started.elapsed().as_secs_f64()
+        );
+    }
+}
