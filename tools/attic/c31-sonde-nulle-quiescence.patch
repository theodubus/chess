+#!/usr/bin/env python3
+"""Lecteur de la sonde C31 — somme les compteurs d'un match joué par le binaire sondé.
+
+  fastchess -engine cmd=<sondé> … -engine cmd=<sondé> … -each tc=8+0.08 proto=uci \\
+            -log file=journal.log level=info engine=true …
+  python3 tools/sonde-c31/sommer.py journal.log
+
+Le binaire sondé imprime, juste avant chaque bestmove, « info string sonde »
+suivi des nœuds de la recherche puis de ses six compteurs, REMIS À ZÉRO à
+chaque impression : chaque ligne vaut pour une recherche, et la somme de
+toutes les lignes vaut pour le match, quelle que soit la vie des processus.
+Compteurs, dans l'ordre de `SONDES` : nœuds de quiescence, dont en échec,
+enfants réversibles de la quiescence (parades tranquilles), dont nulles par
+répétition, par la règle des cinquante coups, par matériel insuffisant.
+"""
+import sys
+
+t = [0] * 7
+n = touchees = rep_s = cinquante_s = 0
+for ligne in open(sys.argv[1], encoding="utf-8", errors="replace"):
+    i = ligne.find("info string sonde")
+    if i < 0:
+        continue
+    v = list(map(int, ligne[i:].split()[3:10]))
+    t = [a + b for a, b in zip(t, v)]
+    n += 1
+    touchees += v[4] + v[5] > 0
+    rep_s += v[4] > 0
+    cinquante_s += v[5] > 0
+noeuds, q, echec, rev, rep, cinquante, insuffisant = t
+print(f"recherches {n}, nœuds {noeuds:,}, quiescence {q:,} ({q / noeuds:.1%}), "
+      f"en échec {echec:,} ({echec / q:.2%} de la quiescence)")
+print(f"parades tranquilles {rev:,} — {rev / echec:.2f} par nœud en échec")
+print(f"nulles : répétition {rep:,} ({rep / rev:.3%} des parades), cinquante coups "
+      f"{cinquante:,} ({cinquante / rev:.4%}), matériel insuffisant {insuffisant:,}")
+print(f"recherches touchées : {touchees} sur {n} ({touchees / n:.1%}) — "
+      f"répétition {rep_s}, cinquante coups {cinquante_s}")
