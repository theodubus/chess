+// 0 nœuds de quiescence, 1 dont en échec, 2 enfants réversibles dans la
+// quiescence (parades tranquilles), 3 dont nulles par répétition, 4 dont nulles
+// par la règle des cinquante coups, 5 dont matériel insuffisant.
+pub static SONDES: [std::sync::atomic::AtomicU64; 6] = [const { std::sync::atomic::AtomicU64::new(0) }; 6];
+fn sonde(i: usize) {
+    SONDES[i].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
