+// SONDE JETABLE (accumulateurs dérivés jamais lus) — vit dans sa rustine.
+pub mod sonde_paresse {
+    use std::cell::RefCell;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static DERIVEES: AtomicU64 = AtomicU64::new(0);
+    pub static JAMAIS_LUES: AtomicU64 = AtomicU64::new(0);
+    pub static PAR_ENFANT_SEUL: AtomicU64 = AtomicU64::new(0);
+    pub static EVALUATIONS: AtomicU64 = AtomicU64::new(0);
+    // Par ply : (dérivé en attente, lu comme base d'un enfant, évalué).
+    thread_local! {
+        static ETAT: RefCell<Vec<(bool, bool, bool)>> = RefCell::new(vec![(false, false, false); 1024]);
+    }
+    fn solde(e: (bool, bool, bool)) {
+        if e.0 {
+            if !e.1 && !e.2 {
+                JAMAIS_LUES.fetch_add(1, Ordering::Relaxed);
+            } else if !e.2 {
+                PAR_ENFANT_SEUL.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+    pub fn derive(parent: usize) {
+        ETAT.with(|t| {
+            let mut t = t.borrow_mut();
+            t[parent].1 = true;
+            solde(t[parent + 1]);
+            t[parent + 1] = (true, false, false);
+        });
+        DERIVEES.fetch_add(1, Ordering::Relaxed);
+    }
+    pub fn evalue(ply: usize) {
+        ETAT.with(|t| t.borrow_mut()[ply].2 = true);
+        EVALUATIONS.fetch_add(1, Ordering::Relaxed);
+    }
+    pub fn racine() {
+        ETAT.with(|t| {
+            let mut t = t.borrow_mut();
+            for e in t.iter_mut() {
+                solde(*e);
+                *e = (false, false, false);
+            }
+        });
+    }
+}
