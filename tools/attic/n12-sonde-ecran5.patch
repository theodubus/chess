+fn n12() -> N12 {
+    static V: std::sync::OnceLock<N12> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N12::default();
+        for part in std::env::var("N12").unwrap_or_default().split('+') {
+            let n: Vec<i32> = part.split(':').skip(1).filter_map(|x| x.parse().ok()).collect();
+            match (part.split(':').next().unwrap_or(""), &n[..]) {
+                ("pvs", []) => v.pvs = true,
+                ("pv", []) => {
+                    v.pvs = true;
+                    v.pv = true;
+                    v.pv_tt = true;
+                    v.pv_rfp = true;
+                    v.pv_nmp = true;
+                    v.pv_lmr = true;
+                }
+                ("pvtt", []) => {
+                    v.pvs = true;
+                    v.pv = true;
+                    v.pv_tt = true;
+                }
+                ("pvrfp", []) => {
+                    v.pvs = true;
+                    v.pv = true;
+                    v.pv_rfp = true;
+                }
+                ("pvnmp", []) => {
+                    v.pvs = true;
+                    v.pv = true;
+                    v.pv_nmp = true;
+                }
+                ("pvlmr", []) => {
+                    v.pvs = true;
+                    v.pv = true;
+                    v.pv_lmr = true;
+                }
+                ("lmrh", [d]) => v.lmrh = Some(*d),
+                ("mal", []) => v.mal = true,
+                ("hp", [t]) => v.hp = Some(*t),
+                ("hpo", [t]) => v.hp_ombre = Some(*t),
