+#!/usr/bin/env python3
+"""Rejoue les flux d'un journal cutechess `-debug all` dans un binaire, chaque
+`go` remplacé par `go depth D` (ou `go nodes N` si D commence par « n ») :
+mêmes positions, dans l'ordre des parties, table et historiques conservés
+d'un coup à l'autre comme en partie. Déterministe à un fil. Rend, par
+variante, le total des nœuds et la somme des compteurs `sonde-n12`.
+
+    N12=pvs python3 rejouer.py <journal> <binaire> <D> [processus]
+
+Copie élargie de tools/sonde-a20/rejouer-profondeur.py (attic) : flux en
+parallèle — des nœuds à profondeur fixe ne dépendent pas de la charge.
+"""
+import re
+import subprocess
+import sys
+from collections import defaultdict
+from concurrent.futures import ThreadPoolExecutor
+
+CMD = re.compile(r'^\d+ >(\w+)\((\d+)\): (.*)$')
+SONDE = re.compile(r'info string sonde-n12 (.*)$')
+journal, binaire, prof = sys.argv[1], sys.argv[2], sys.argv[3]
+proc = int(sys.argv[4]) if len(sys.argv) > 4 else 4
+go = f'go nodes {prof[1:]}' if prof.startswith('n') else f'go depth {prof}'
+
+flux = defaultdict(list)
+for brut in open(journal, errors='replace'):
+    m = CMD.match(brut.rstrip('\n'))
+    if m:
+        flux[(m[1], m[2])].append(m[3])
+cles = sorted(flux, key=lambda k: (int(k[1]), k[0]))
+
+
+def rejouer(cle):
+    p = subprocess.Popen([binaire], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                         text=True, bufsize=1)
+
+    def envoyer(s):
+        p.stdin.write(s + '\n')
+        p.stdin.flush()
+
+    def attendre(fin):
+        nodes, sonde, best = None, {}, None
+        while True:
+            ligne = p.stdout.readline()
+            if not ligne:
+                sys.exit("le moteur s'est tu")
+            if ligne.startswith('info depth') and ' nodes ' in ligne:
+                nodes = int(ligne.split(' nodes ')[1].split()[0])
+            m = SONDE.search(ligne)
+            if m:
+                sonde = {k: int(v) for k, v in (x.split('=') for x in m[1].split())}
+            if ligne.startswith(fin):
+                if fin == 'bestmove':
+                    best = ligne.split()[1]
+                return nodes, sonde, best
+
+    envoyer('uci')
+    attendre('uciok')
+    somme, n, compteurs, coups = 0, 0, defaultdict(int), []
+    for cmd in flux[cle]:
+        if cmd in ('uci', 'quit') or cmd.startswith('debug'):
+            continue
+        if cmd.startswith('go'):
+            envoyer(go)
+            nodes, sonde, best = attendre('bestmove')
+            somme += nodes or 0
+            n += 1
+            coups.append(best)
+            for k, v in sonde.items():
+                compteurs[k] += v
+        elif cmd == 'isready':
+            envoyer('isready')
+            attendre('readyok')
+        else:
+            envoyer(cmd)
+    envoyer('quit')
+    p.wait(timeout=30)
+    return cle, n, somme, compteurs, coups
+
+
+total, recherches, tous = 0, 0, defaultdict(int)
+with ThreadPoolExecutor(max_workers=proc) as ex:
+    for cle, n, somme, compteurs, coups in ex.map(rejouer, cles):
+        print(f"{cle[0]}({cle[1]}) {n} {somme} {' '.join(coups)}", flush=True)
+        total += somme
+        recherches += n
+        for k, v in compteurs.items():
+            tous[k] += v
+print(f"TOTAL {recherches} {total}")
+print("SONDE " + ' '.join(f'{k}={v}' for k, v in sorted(tous.items())))
