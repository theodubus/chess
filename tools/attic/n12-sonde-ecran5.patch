+"""Comme analyse.py, pour un préfixe de série donné (r, rb, rc) : arbre, accord, compteurs."""
+import glob, os, re, sys
+ICI = os.path.dirname(os.path.abspath(__file__))
+def lire(f):
+    flux, total, sonde = {}, None, {}
+    for ligne in open(f):
+        if ligne.startswith('TOTAL'):
+            total = int(ligne.split()[2])
+        elif ligne.startswith('SONDE'):
+            sonde = {k: int(v) for k, v in (x.split('=') for x in ligne.split()[1:])}
+        else:
+            m = re.match(r'^(\w+\(\d+\)) (\d+) (\d+) ?(.*)$', ligne.rstrip('\n'))
+            if m:
+                flux[m[1]] = m[4].split()
+    return flux, total, sonde
+pre = sys.argv[1]
+for d in sys.argv[2:]:
+    base = os.path.join(ICI, f'{pre}-none-{d}.txt')
+    if not os.path.exists(base):
+        continue
+    fb, tb, sb = lire(base)
+    if tb is None:
+        continue
+    print(f'== {pre}, profondeur {d} : main {tb:,} nœuds'.replace(',', ' '))
+    print('   main : ' + ' '.join(f'{k}={v}' for k, v in sorted(sb.items()) if v))
+    for f in sorted(glob.glob(os.path.join(ICI, f'{pre}-*-{d}.txt'))):
+        nom = os.path.basename(f)[len(pre) + 1:-len(f'-{d}.txt')]
+        fv, tv, sv = lire(f)
+        if tv is None or nom == 'none':
+            continue
+        n = same = 0
+        for k, coups in fb.items():
+            for a, b in zip(coups, fv.get(k, [])):
+                n += 1
+                same += a == b
+        diff = {k: v for k, v in sv.items() if v and v != sb.get(k)}
+        print(f'{nom:20s} {100 * (tv / tb - 1):+7.2f} %  coup changé {100 - 100 * same / max(n, 1):5.2f} %  '
+              + ' '.join(f'{k}={v}' for k, v in sorted(diff.items())))
