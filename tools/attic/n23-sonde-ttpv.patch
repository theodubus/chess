 /// La réduction d'un tranquille, modulée par sa note : `note / diviseur`
 /// plis de moins, ou de plus si elle est négative ; jamais sous zéro, ni
 /// au point de sauter la profondeur restante.
+#[derive(Clone, Copy)]
+struct N26 { k: i32, nolfl: bool, prop: bool, rfp: bool, nopvn: bool, pvn: bool }
+fn n26() -> N26 {
+    static V: std::sync::OnceLock<N26> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let mut v = N26 { k: 0, nolfl: false, prop: false, rfp: false, nopvn: false, pvn: false };
+        for part in std::env::var("N26").unwrap_or_default().split('+').filter(|p| !p.is_empty()) {
+            let mut it = part.split(':');
+            let key = it.next().unwrap_or("");
+            let x: i32 = it.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+            match key { "k" => v.k = x, "nolfl" => v.nolfl = true, "prop" => v.prop = true, "rfp" => v.rfp = true, "nopvn" => v.nopvn = true, "pvn" => v.pvn = true, _ => panic!("N26 {part}") }
+        }
+        v
+    })
+}
+pub static N26C: [std::sync::atomic::AtomicU64; 4] = [const { std::sync::atomic::AtomicU64::new(0) }; 4];
+
 fn modulated_reduction(base: i32, note: i32, depth: i32) -> i32 {
     (base - note / LMR_HISTORY_DIVISOR).min(depth - 2).max(0)
 }
