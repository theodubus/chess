@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Facteurs qui égalisent, marge par marge, le taux du réseau sur celui de la faite main (B8).
+
+  python3 facteurs.py <binaire> <dossier réseau> <dossier faite main>
+
+- élagage delta : élaguer si stand_pat + m × (gain + 200) ≤ alpha — le gain et
+  la marge sont en unités de la faite main, le facteur m les porte en unités du
+  réseau ; élagage fautif si la valeur rejouée après la capture dépasse alpha ;
+- aspiration : première fenêtre de demi-largeur δ, en échec si le score de
+  l'itération s'écarte du précédent d'au moins δ ; facteur δ / 25.
+Le plus petit facteur dont le taux du réseau ne dépasse pas celui de la faite
+main à 1,00, sur une grille de 0,1.
+"""
+import sys
+from multiprocessing import Pool
+
+sys.argv = sys.argv  # lire.py lit ses arguments à l'import
+import lire  # noqa: E402
+
+DELTA_MARGIN = 200
+
+
+def main():
+    delta = {k: lire.lines(d, "delta") for k, d in lire.DIRS.items()}
+    with Pool(lire.WORKERS) as pool:
+        rows = pool.map(lire.rejouer_delta, delta["net"] + delta["hc"], chunksize=16)
+    data = {"net": [], "hc": []}
+    for kind, stand_pat, gain, alpha, pruned, v in rows:
+        if v is not None and abs(v) < lire.MATE:
+            data[kind].append((stand_pat, gain, alpha, v))
+
+    def taux(points, m):
+        el = [v > alpha for sp, g, alpha, v in points if sp + m * (g + DELTA_MARGIN) <= alpha]
+        return (sum(el) / len(el) if el else 0.0), len(el) / max(len(points), 1)
+
+    cible, part_hc = taux(data["hc"], 1.0)
+    print(f"élagage delta — faite main à × 1,0 : {cible:.2%} fautifs, {part_hc:.1%} élaguées")
+    egal = None
+    for m10 in range(5, 61):
+        m = m10 / 10
+        r, part = taux(data["net"], m)
+        if egal is None and r <= cible:
+            egal = m
+        if m10 in (5, 10, 15, 20, 22, 24, 25, 30, 40, 50, 60):
+            print(f"  réseau × {m:.1f} : {r:.2%} fautifs, {part:.1%} élaguées")
+    print(f"  facteur qui égalise : {'aucun jusqu à × 6' if egal is None else f'× {egal:.1f}'}")
+
+    asp = {k: lire.lines(d, "asp") for k, d in lire.DIRS.items()}
+    ecarts = {k: [abs(int(r[6]) - int(r[5])) for r in v if abs(int(r[5])) < lire.MATE and abs(int(r[6])) < lire.MATE]
+              for k, v in asp.items()}
+
+    def echec(xs, delta):
+        return sum(x >= delta for x in xs) / len(xs)
+
+    cible = echec(ecarts["hc"], 25)
+    print(f"\naspiration — faite main à δ = 25 : {cible:.1%} des itérations hors de la première fenêtre")
+    egal = None
+    for d in range(10, 201, 5):
+        r = echec(ecarts["net"], d)
+        if egal is None and r <= cible:
+            egal = d
+        if d in (15, 25, 35, 50, 60, 75, 100, 150, 200):
+            print(f"  réseau δ = {d} : {r:.1%}")
+    print(f"  δ qui égalise : {egal} — facteur × {egal / 25:.2f}" if egal else "  aucun jusqu à 200")
+
+
+if __name__ == "__main__":
+    main()
