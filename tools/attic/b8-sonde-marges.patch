+// Échantillonnage par compteur, jamais par le hasard.
+pub mod sonde_b8 {
+    use std::io::Write;
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    use std::sync::{Mutex, OnceLock};
+
+    pub const RFP_EVERY: u64 = 20_000;
+    pub const DELTA_EVERY: u64 = 150_000;
+    pub static RFP_SEEN: AtomicU64 = AtomicU64::new(0);
+    pub static DELTA_SEEN: AtomicU64 = AtomicU64::new(0);
