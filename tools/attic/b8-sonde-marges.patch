+    struct Files {
+        rfp: std::fs::File,
+        delta: std::fs::File,
+        asp: std::fs::File,
+    }
+
+    fn files() -> Option<&'static Mutex<Files>> {
+        static FILES: OnceLock<Option<Mutex<Files>>> = OnceLock::new();
+        FILES
+            .get_or_init(|| {
+                let dir = std::env::var("SONDE_B8").ok()?;
+                let pid = std::process::id();
+                let open = |name: &str| {
