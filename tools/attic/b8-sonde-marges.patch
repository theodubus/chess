@@ -0,0 +1,254 @@
+#!/usr/bin/env python3
+"""Lecteur de la sonde B8 — rejoue hors partie les nœuds échantillonnés et rend les rapports.
+
+  python3 lire.py <binaire> <dossier réseau> <dossier faite main>
+
+Chaque dossier porte les rfp.<pid>.tsv, delta.<pid>.tsv et asp.<pid>.tsv qu'a
+écrits le binaire sondé pendant ses parties (SONDE_B8=<dossier>). Le rejeu se
+fait SANS SONDE_B8 : le binaire se comporte alors comme `main`.
+
+- futilité inverse : `go depth d` depuis la position du nœud, table de 1 Mio,
+  même évaluation ; E = statique − score. Les scores de mat sont écartés
+  (comptés). Centiles de E par profondeur, et la faute de la marge actuelle :
+  parmi les nœuds coupés, la part dont le score rejoué est sous beta.
+- élagage delta : `go depth 1` après la capture ; valeur V = −score ; élaguée à
+  tort si V > alpha.
+- aspiration : taux d'échec par itération à fenêtre, et la part des nœuds
+  dépensée en recherches échouées.
+Intervalles à 95 % par rééchantillonnage (2 000 tirages, graine fixe).
+"""
+import glob
+import os
+import random
+import subprocess
+import sys
+from multiprocessing import Pool
+
+BIN = sys.argv[1]
+DIRS = {"net": sys.argv[2], "hc": sys.argv[3]}
+WORKERS = 3
+MATE = 20000
+
+
+def lines(d, prefix):
+    out = []
+    for f in sorted(glob.glob(os.path.join(d, f"{prefix}.*.tsv"))):
+        with open(f) as fh:
+            out += [l.rstrip("\n").split("\t") for l in fh if l.strip()]
+    return out
+
+
+_eng = {}
+
+
+def engine(kind):
+    if kind not in _eng:
+        env = {k: v for k, v in os.environ.items() if k != "SONDE_B8"}
+        p = subprocess.Popen([BIN], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1, env=env)
+        send(p, "uci", "uciok")
+        send(p, "setoption name Hash value 1")
+        if kind == "hc":
+            send(p, "setoption name EvalFile value <none>")
+        send(p, "isready", "readyok")
+        _eng[kind] = p
+    return _eng[kind]
+
+
+def send(p, cmd, until=None):
+    p.stdin.write(cmd + "\n")
+    p.stdin.flush()
+    if until:
+        while True:
+            l = p.stdout.readline()
+            if not l or l.strip() == until:
+                return
+
+
+def search(kind, position, depth):
+    """Score au dernier `info depth <depth>` complet, du côté du trait ; None si mat."""
+    p = engine(kind)
+    send(p, "ucinewgame")
+    send(p, "isready", "readyok")
+    send(p, position)
+    send(p, f"go depth {depth}")
+    score = None
+    while True:
+        l = p.stdout.readline()
+        if not l:
+            return None
+        t = l.split()
+        if t[:1] == ["info"] and "score" in t and "depth" in t:
+            i = t.index("score")
+            d = int(t[t.index("depth") + 1])
+            if d == depth and "upperbound" not in t and "lowerbound" not in t:
+                score = int(t[i + 2]) if t[i + 1] == "cp" else None
+                if t[i + 1] == "mate":
+                    score = None
+        if t[:1] == ["bestmove"]:
+            return score
+
+
+def rejouer_rfp(row):
+    fen, depth, beta, static, other, cut, kind = row
+    s = search(kind, f"position fen {fen}", int(depth))
+    return (kind, int(depth), int(beta), int(static), int(other), int(cut), s)
+
+
+def rejouer_delta(row):
+    fen, mv, stand_pat, gain, alpha, pruned, kind = row
+    s = search(kind, f"position fen {fen} moves {mv}", 1)
+    return (kind, int(stand_pat), int(gain), int(alpha), int(pruned), None if s is None else -s)
+
+
+def centile(xs, q):
+    xs = sorted(xs)
+    return xs[min(len(xs) - 1, int(q * len(xs)))]
+
+
+def bootstrap(a, b, stat, n=2000, seed=20260930):
+    rng = random.Random(seed)
+    rs = []
+    for _ in range(n):
+        sa = [a[rng.randrange(len(a))] for _ in a]
+        sb = [b[rng.randrange(len(b))] for _ in b]
+        vb = stat(sb)
+        rs.append(stat(sa) / vb if vb else float("inf"))
+    rs.sort()
+    return rs[int(0.025 * n)], rs[int(0.975 * n)]
+
+
+def main():
+    # Un nœud sur PAS, dans l'ordre des fichiers : le rejeu tient dans la durée
+    # de vie du conteneur. Équivaut à un N plus grand dans la sonde.
+    PAS = int(os.environ.get("PAS_RFP", "1"))
+    rfp = {k: lines(d, "rfp")[PAS - 1::PAS] for k, d in DIRS.items()}
+    delta = {k: lines(d, "delta") for k, d in DIRS.items()}
+    asp = {k: lines(d, "asp") for k, d in DIRS.items()}
+    print("échantillons — futilité :", {k: len(v) for k, v in rfp.items()},
+          " delta :", {k: len(v) for k, v in delta.items()},
+          " aspiration :", {k: len(v) for k, v in asp.items()}, flush=True)
+
+    with Pool(WORKERS) as pool:
+        r_rfp = pool.map(rejouer_rfp, rfp["net"] + rfp["hc"], chunksize=16)
+        r_delta = pool.map(rejouer_delta, delta["net"] + delta["hc"], chunksize=16)
+
+    print("\n== futilité inverse : E = statique − score rejoué à la profondeur du nœud ==")
+    E = {"net": {}, "hc": {}}
+    fautes = {"net": [0, 0], "hc": [0, 0]}
+    mats = {"net": 0, "hc": 0}
+    pente = {"net": [], "hc": []}
+    for kind, depth, beta, static, other, cut, s in r_rfp:
+        if s is None or abs(s) >= MATE:
+            mats[kind] += 1
+            continue
+        E[kind].setdefault(depth, []).append(static - s)
+        E[kind].setdefault(0, []).append(static - s)
+        if cut:
+            fautes[kind][0] += 1
+            fautes[kind][1] += s < beta
+        if other != -2147483648:
+            pente[kind].append((static, other))
+    print(f"  scores de mat écartés : {mats}")
+    print(f"  {'prof.':>5} {'n net':>6} {'n hc':>6}  {'c50 net':>8} {'c90 net':>8} {'c99 net':>8}  {'c50 hc':>7} {'c90 hc':>7} {'c99 hc':>7}  {'c90 net/hc':>10}  IC 95 %")
+    for d in sorted(set(E["net"]) | set(E["hc"])):
+        a, b = E["net"].get(d, []), E["hc"].get(d, [])
+        if len(a) < 30 or len(b) < 30:
+            continue
+        q = lambda xs: centile(xs, 0.9)
+        lo, hi = bootstrap(a, b, q)
+        print(f"  {('tous' if d == 0 else d):>5} {len(a):>6} {len(b):>6}  "
+              f"{centile(a, .5):>8} {centile(a, .9):>8} {centile(a, .99):>8}  "
+              f"{centile(b, .5):>7} {centile(b, .9):>7} {centile(b, .99):>7}  "
+              f"{q(a) / q(b) if q(b) else float('inf'):>10.2f}  [{lo:.2f} ; {hi:.2f}]")
+    for k in ("net", "hc"):
+        n, f = fautes[k]
+        print(f"  coupures fautives, marge actuelle — {k} : {f} sur {n} ({f / max(n, 1):.2%})")
+    # Le rapport des taux de coupures fautives, et le facteur de marge qui les égalise.
+    noeuds = {"net": [], "hc": []}
+    for kind, depth, beta, static, other, cut, s in r_rfp:
+        if s is not None and abs(s) < MATE:
+            noeuds[kind].append((depth, beta, static, s))
+
+    def fautes_a(nodes, m):
+        coupes = [(beta, s) for depth, beta, static, s in nodes if static - m * 100 * depth >= beta]
+        return [1 if s < beta else 0 for beta, s in coupes], len(coupes)
+
+    fa, _ = fautes_a(noeuds["net"], 1.0)
+    fb, _ = fautes_a(noeuds["hc"], 1.0)
+    if fa and fb:
+        rate = lambda xs: sum(xs) / len(xs)
+        lo, hi = bootstrap(fa, fb, rate)
+        print(f"  RAPPORT des taux de coupures fautives réseau / faite main : "
+              f"{rate(fa) / max(rate(fb), 1e-9):.2f}  [{lo:.2f} ; {hi:.2f}]")
+        cible = rate(fb)
+        print(f"  facteur de marge : taux fautif et part des candidats coupés, réseau (faite main à 1,00 : "
+              f"{cible:.2%} fautives, {len(fb) / max(len(noeuds['hc']), 1):.1%} coupés)")
+        m_egal = None
+        for m10 in range(5, 51, 1):
+            m = m10 / 10
+            f, n = fautes_a(noeuds["net"], m)
+            r = rate(f) if f else 0.0
+            if m_egal is None and r <= cible:
+                m_egal = m
+            if m10 in (5, 8, 10, 12, 15, 20, 25, 30, 40, 50):
+                print(f"    × {m:.1f} : {r:.2%} fautives, {n / max(len(noeuds['net']), 1):.1%} coupés")
+        print(f"  facteur qui égalise le taux fautif du réseau sur celui de la faite main : "
+              f"{'aucun jusqu à × 5' if m_egal is None else f'× {m_egal:.1f}'}")
+    # Pente : l'échelle du réseau contre la faite main aux mêmes nœuds.
+    pts = [(o, s) for s, o in pente["net"]] + [(s, o) for s, o in pente["hc"]]  # (hc, net)
+    pts = [(h, n) for h, n in pts if abs(h) <= 1500]
+    if pts:
+        num = sum(h * n for h, n in pts)
+        den = sum(h * h for h, n in pts)
+        ratios = sorted(abs(n) / abs(h) for h, n in pts if abs(h) >= 50)
+        print(f"  échelle réseau / faite main aux nœuds de la futilité : pente {num / den:.2f} (|hc| ≤ 1500, n = {len(pts)}), "
+              f"rapport médian {ratios[len(ratios) // 2]:.2f} (|hc| ≥ 50)")
+
+    print("\n== élagage delta : élaguée à tort si la valeur rejouée après la capture dépasse alpha ==")
+    stats = {}
+    for kind, stand_pat, gain, alpha, pruned, v in r_delta:
+        st = stats.setdefault(kind, {"cand": 0, "pr": 0, "faute": [], "mat": 0})
+        st["cand"] += 1
+        if v is None:
+            st["mat"] += 1
+            continue
+        if pruned:
+            st["pr"] += 1
+            st["faute"].append(1 if v > alpha else 0)
+    for k in ("net", "hc"):
+        st = stats.get(k)
+        if not st:
+            continue
+        f = st["faute"]
+        print(f"  {k} : {st['cand']} candidates, {st['pr']} élaguées ({st['pr'] / max(st['cand'], 1):.1%}), "
+              f"fautives {sum(f)} ({sum(f) / max(len(f), 1):.2%}), mats écartés {st['mat']}")
+    if stats.get("net") and stats.get("hc") and stats["net"]["faute"] and stats["hc"]["faute"]:
+        rate = lambda xs: sum(xs) / len(xs)
+        a, b = stats["net"]["faute"], stats["hc"]["faute"]
+        lo, hi = bootstrap(a, b, rate)
+        print(f"  rapport des taux fautifs réseau / faite main : {rate(a) / max(rate(b), 1e-9):.2f}  [{lo:.2f} ; {hi:.2f}]")
+
+    print("\n== aspiration : échecs par itération à fenêtre ==")
+    per = {}
+    for row in asp["net"] + asp["hc"]:
+        it, fl, fh, nf, nt, prev, score, kind = row
+        per.setdefault(kind, []).append((int(fl) + int(fh), int(nf), int(nt)))
+    for k in ("net", "hc"):
+        xs = per.get(k, [])
+        if not xs:
+            continue
+        fails = sum(x[0] for x in xs)
+        with_fail = sum(1 for x in xs if x[0])
+        print(f"  {k} : {len(xs)} itérations, {fails / len(xs):.2f} échec par itération, "
+              f"{with_fail / len(xs):.1%} en échec au moins une fois, "
+              f"{sum(x[1] for x in xs) / max(sum(x[2] for x in xs), 1):.1%} des nœuds en recherches échouées")
+    if per.get("net") and per.get("hc"):
+        a = [x[0] for x in per["net"]]
+        b = [x[0] for x in per["hc"]]
+        mean = lambda xs: sum(xs) / len(xs)
+        lo, hi = bootstrap(a, b, mean)
+        print(f"  rapport des échecs par itération réseau / faite main : {mean(a) / mean(b):.2f}  [{lo:.2f} ; {hi:.2f}]")
+
+
+if __name__ == "__main__":
+    main()
