+                        .create(true)
+                        .append(true)
+                        .open(format!("{dir}/{name}.{pid}.tsv"))
+                        .ok()
+                };
+                Some(Mutex::new(Files { rfp: open("rfp")?, delta: open("delta")?, asp: open("asp")? }))
+            })
+            .as_ref()
+    }
+
+    pub fn active() -> bool {
+        files().is_some()
+    }
+
+    pub fn rfp(line: &str) {
+        if let Some(f) = files() && let Ok(mut f) = f.lock() {
+            let _ = writeln!(f.rfp, "{line}");
+        }
+    }
+
+    pub fn delta(line: &str) {
+        if let Some(f) = files() && let Ok(mut f) = f.lock() {
+            let _ = writeln!(f.delta, "{line}");
+        }
+    }
+
+    pub fn asp(line: &str) {
+        if let Some(f) = files() && let Ok(mut f) = f.lock() {
+            let _ = writeln!(f.asp, "{line}");
+        }
+    }
+
+    pub fn tick(counter: &AtomicU64, every: u64) -> bool {
+        counter.fetch_add(1, Relaxed) % every == every - 1
+    }
+}
