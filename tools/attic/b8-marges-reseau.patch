+    #[test]
+    fn les_marges_suivent_l_echelle_de_l_evaluation_qui_joue() {
+        // B8 : l'aspiration et l'élagage delta ont été posés en unités de la
+        // faite main ; au réseau, ils prennent le facteur de
+        // `NETWORK_MARGIN_PERCENT`, et la faite main garde les siennes au bit
+        // près — le banc et les tests de recherche n'en bougent pas.
+        let mut s = search();
+        assert_eq!(
+            s.scaled_margin(ASPIRATION_DELTA),
+            25,
+            "faite main : intacte"
+        );
+        assert_eq!(s.scaled_margin(1_000), 1_000, "faite main : intacte");
+        s.set_network(Some(Arc::new(crate::nnue::testing::random_network(1))));
+        assert_eq!(s.scaled_margin(ASPIRATION_DELTA), 56, "réseau : 25 × 2,24");
+        assert_eq!(s.scaled_margin(1_000), 2_240, "réseau : 1 000 × 2,24");
+        s.set_network(None);
+        assert_eq!(
+            s.scaled_margin(ASPIRATION_DELTA),
+            25,
+            "retour à la faite main"
+        );
+    }
