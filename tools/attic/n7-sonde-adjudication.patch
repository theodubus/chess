+#!/bin/bash
+# Sonde n° 7 — l'adjudication de gain à l'échelle du réseau (tools/README.md,
+# section « N° 7 — un meilleur réseau »). Les mêmes parties jouées deux fois,
+# avec l'adjudication puis sans (SONDE_ADJ hors d'atteinte), au réseau puis à
+# la faite main pour témoin. Chaque partie étant une fonction pure de (graine,
+# numéro, nœuds), les deux passes jouent les mêmes coups jusqu'à l'adjudication.
+# À lancer depuis la racine du dépôt, la rustine appliquée.
+set -euo pipefail
+N=${N:-3000}
+GRAINE=${GRAINE:-20260929}
+OUT=${1:-/tmp/sonde-n7}
+cargo build --release -q -p shallowred-tools --bin nnue-datagen
+for ev in embedded none; do
+  for mode in avec sans; do
+    rm -rf "$OUT/d-$ev-$mode"; mkdir -p "$OUT/d-$ev-$mode"
+    if [ "$mode" = sans ]; then export SONDE_ADJ=1000000; else unset SONDE_ADJ; fi
+    ./target/release/nnue-datagen --out "$OUT/d-$ev-$mode" --threads 4 --nodes 5000 \
+      --seed "$GRAINE" --games "$N" --eval "<$ev>" \
+      > "$OUT/stats-$ev-$mode.txt" 2> "$OUT/parties-$ev-$mode.txt"
+  done
+done
+python3 tools/sonde-n7/lire.py "$OUT" embedded none
