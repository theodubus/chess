+# Lecteur de la sonde n° 7 : lire.py <dossier> <évaluation>... — voir rejouer.sh.
+import sys, collections
+OUT = sys.argv[1]
+def lire(ev, mode):
+    parties, ecartees = {}, set()
+    for l in open(f"{OUT}/parties-{ev}-{mode}.txt"):
+        f = l.split()
+        if f and f[0] == "PARTIE":
+            parties[int(f[1])] = (f[2], int(f[3]), f[4] == "1")
+        elif f and f[0] == "ECARTEE":
+            ecartees.add(int(f[1]))
+    return parties, ecartees
+for ev in sys.argv[2:]:
+    A, eA = lire(ev, "avec"); B, eB = lire(ev, "sans")
+    assert eA == eB, "écartées différentes"
+    communs = sorted(set(A) & set(B))
+    temoin_ko = [i for i in communs if not A[i][2] and A[i] != (B[i][0], B[i][1], False)]
+    adj = [i for i in communs if A[i][2]]
+    c = collections.Counter()
+    plafond = 0
+    plus_court = 0
+    for i in adj:
+        ra, la, _ = A[i]; rb, lb, _ = B[i]
+        if lb < la: plus_court += 1
+        if rb == ra: c["confirmé"] += 1
+        elif rb == "1/2":
+            c["nulle"] += 1
+            if lb >= 400: plafond += 1
+        else: c["renversé"] += 1
+    n = len(communs); na = len(adj)
+    autre = c["nulle"] + c["renversé"]
+    print(f"== {ev} : {n} parties jouées, {len(eA)} écartées ; adjugées {na} ({100*na/max(n,1):.1f} %)")
+    print(f"   finies autrement : {autre} ({100*autre/max(na,1):.2f} % des adjugées) — nulles {c['nulle']} (dont plafond de 400 demi-coups : {plafond}), renversées {c['renversé']}")
+    print(f"   témoin de la sonde (non adjugées identiques avec et sans) : {len(communs)-na-len(temoin_ko)} identiques, {len(temoin_ko)} différentes ; adjugées plus longues sans adjudication : {na-plus_court}/{na}")
+    la_moy = sum(A[i][1] for i in adj)/max(na,1); lb_moy = sum(B[i][1] for i in adj)/max(na,1)
+    print(f"   longueur moyenne des adjugées : {la_moy:.1f} demi-coups avec, {lb_moy:.1f} sans")
