{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/verify-on-stop.sh",
            "timeout": 180,
            "statusMessage": "vérification de l'arbre"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .socle/socle hook stop",
            "timeout": 600,
            "statusMessage": "contrôles de fin de tour"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .claude/hooks/no-fabricated-sha.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|AskUserQuestion|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .socle/socle hook pre-tool-use",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && tools/etat.sh",
            "timeout": 15,
            "statusMessage": "état du travail en cours"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 .socle/socle hook session-start",
            "timeout": 300,
            "statusMessage": "état dérivé du projet"
          }
        ]
      }
    ]
  }
}
